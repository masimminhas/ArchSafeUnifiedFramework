  <globalHazards id="HAZ_01" name="Unintended_Vehicle_Acceleration" description="Vehicle fails to brake or accelerates when emergency braking should occur" riskLevel="CATASTROPHIC" relatedBlocks="//@rootBlocks.0 //@rootBlocks.3" mitigationStatus="PARTIALLY_MITIGATED" hazardCategory="LOSS_OF_FUNCTION" severityJustification="Can lead to high-speed collision with severe injury or fatality"/>
  <globalHazards id="HAZ_02" name="False_Emergency_Braking" description="System activates emergency braking without actual threat" riskLevel="CRITICAL_RISK" relatedBlocks="//@rootBlocks.0 //@rootBlocks.1 //@rootBlocks.2" mitigationStatus="PARTIALLY_MITIGATED" hazardCategory="UNINTENDED_FUNCTION" severityJustification="Can cause rear-end collision or loss of vehicle control"/>
  <globalHazards id="HAZ_03" name="Delayed_AEB_Activation" description="Emergency braking activates too late to prevent collision" riskLevel="CATASTROPHIC" relatedBlocks="//@rootBlocks.0 //@rootBlocks.1 //@rootBlocks.4" mitigationStatus="PARTIALLY_MITIGATED" hazardCategory="TIMING_FAILURE" severityJustification="Insufficient time to decelerate results in collision"/>
  <globalHazards id="HAZ_04" name="Sensor_Blind_Spot" description="Sensors fail to detect obstacles in critical situations" riskLevel="CATASTROPHIC" relatedBlocks="//@rootBlocks.1 //@rootBlocks.2" mitigationStatus="PARTIALLY_MITIGATED" severityJustification="No warning or braking for imminent collision"/>
  <globalHazards id="HAZ_05" name="Insufficient_Braking_Force" description="Brake actuator cannot generate required deceleration" riskLevel="CATASTROPHIC" relatedBlocks="//@rootBlocks.3" mitigationStatus="FULLY_MITIGATED" severityJustification="Vehicle cannot stop in time despite system activation"/>
  <globalHazards id="HAZ_06" name="Communication_Loss" description="CAN bus failure prevents sensor data from reaching controller" riskLevel="CRITICAL_RISK" relatedBlocks="//@rootBlocks.4 //@rootBlocks.0 //@rootBlocks.6" mitigationStatus="PARTIALLY_MITIGATED" hazardCategory="LOSS_OF_FUNCTION" severityJustification="System cannot function without sensor input"/>
