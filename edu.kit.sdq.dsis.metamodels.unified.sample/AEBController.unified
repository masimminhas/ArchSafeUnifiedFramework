  <fmeaAnalysis id="fmea_aeb_001" name="AEB_System_FMEA" rpnThreshold="100">
    <fmeaItems id="fmea_item_001" name="Sensor_Data_Corruption" severity="9" occurrence="4" detection="5" localEffect="Incorrect distance measurement to forward mobile object" systemEffect="AV may not maintain minimum safe distance leading to collision" recommendedAction="Implement sensor fusion and redundancy; add plausibility checks" actionStatus="IN_PROGRESS" failureMode="//@rootBlocks.0/@failureModes.0" analyzedComponent="//@rootBlocks.0" responsiblePerson="Minhas"/>
    <fmeaItems id="fmea_item_002" name="CIBd_Calculation_Error" severity="8" occurrence="3" detection="6" localEffect="Incorrect collision imminent braking distance calculated" systemEffect="Late or early brake application" recommendedAction="Add runtime monitoring of CIBd calculations; implement watchdog" failureMode="//@rootBlocks.1/@failureModes.0" analyzedComponent="//@rootBlocks.1"/>
    <fmeaItems id="fmea_item_003" name="Brake_Actuation_Delay" severity="7" occurrence="5" detection="4" localEffect="Braking force command not executed in time" systemEffect="Vehicle reaches minimum safe distance before stopping" recommendedAction="Reduce communication latency; implement fail-operational braking" actionStatus="COMPLETED" failureMode="//@rootBlocks.2/@failureModes.1" analyzedComponent="//@rootBlocks.2"/>
    <fmeaItems id="fmea_item_004" name="BFC_Communication_Loss" severity="9" occurrence="2" detection="7" localEffect="Brake force command not received by actuator" systemEffect="No braking action despite collision threat" recommendedAction="Implement redundant communication channels with CRC" actionStatus="VERIFIED" analyzedComponent="//@rootBlocks.3"/>
    <fmeaItems id="fmea_item_005" name="Excessive_Deceleration" severity="8" occurrence="3" detection="5" localEffect="Braking force exceeds required deceleration rate" systemEffect="Occupants exposed to unhealthy g-forces" recommendedAction="Implement braking force limiter based on occupant safety thresholds" actionStatus="IN_PROGRESS" failureMode="//@rootBlocks.2/@failureModes.0" analyzedComponent="//@rootBlocks.2"/>
  </fmeaAnalysis>
