<?xml version="1.0" encoding="UTF-8"?>
<unified:UnifiedSystemModel xmi:version="2.0" 
    xmlns:xmi="http://www.omg.org/XMI" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xmlns:unified="http://edu.kit.sdq.dsis.metamodel/unified"
    xmi:id="_ACC_System_Root"
    name="ACC_System"
    modelVersion="1.0"
    description="Adaptive Cruise Control System with Emergency Braking - ISO 26262 Compliant Reference Model">
  
  <!-- ============================================= -->
  <!-- ANALYSIS METADATA -->
  <!-- ============================================= -->
  <analysisMetadata xmi:id="_metadata_01"
    lastAnalysisDate="2025-01-07T10:00:00"
    completenessScore="89"
    consistencyScore="92"
    hazardCoverage="1.0"
    fmeaCoverage="0.93"
    traceabilityDensity="0.89"
    cyclomaticComplexity="18"/>
  
  <!-- ============================================= -->
  <!-- SYSTEM BLOCKS (11 Non-Safety-Critical) -->
  <!-- ============================================= -->
  
  <systemBlocks xmi:id="_SB_01" 
    name="Short_Range_Radar" 
    blockType="SENSOR"
    description="24 GHz radar for detecting close-range objects (0-30m) during cut-in scenarios and low-speed following."/>
  
  <systemBlocks xmi:id="_SB_02" 
    name="Yaw_Rate_Sensor" 
    blockType="SENSOR"
    description="Gyroscopic sensor measuring vehicle rotation rate. Used for curve compensation in distance calculations."/>
  
  <systemBlocks xmi:id="_SB_03" 
    name="Brake_Pressure_Monitor" 
    blockType="SENSOR"
    description="Monitors actual brake pressure for closed-loop control and fault detection."/>
  
  <systemBlocks xmi:id="_SB_04" 
    name="Throttle_Position_Monitor" 
    blockType="SENSOR"
    description="Verifies throttle actuator position matches commanded value."/>
  
  <systemBlocks xmi:id="_SB_05" 
    name="Driver_Display_Unit" 
    blockType="USER_INTERFACE"
    description="Dashboard display showing ACC status, set speed, following distance indicator, and system warnings. 7-inch TFT LCD."/>
  
  <systemBlocks xmi:id="_SB_06" 
    name="Haptic_Feedback_Module" 
    blockType="USER_INTERFACE"
    description="Steering wheel vibration for driver alerts during critical situations."/>
  
  <systemBlocks xmi:id="_SB_07" 
    name="Control_Stalk_Interface" 
    blockType="USER_INTERFACE"
    description="Physical lever for ACC activation, set speed adjustment, and time-gap selection."/>
  
  <systemBlocks xmi:id="_SB_08" 
    name="Mode_Selector_Switch" 
    blockType="USER_INTERFACE"
    description="Button interface for selecting ACC modes: Cruise, Adaptive, Emergency Braking Disable."/>
  
  <systemBlocks xmi:id="_SB_09" 
    name="CAN_Gateway" 
    blockType="COMMUNICATION"
    description="Bridges multiple CAN bus networks (powertrain, chassis, infotainment) and routes ACC messages. 500 kbps."/>
  
  <systemBlocks xmi:id="_SB_10" 
    name="Ethernet_Backbone" 
    blockType="COMMUNICATION"
    description="High-bandwidth network for camera raw data transmission to sensor fusion controller. 1 Gbps."/>
  
  <!-- ============================================= -->
  <!-- SAFETY-CRITICAL BLOCKS (14 with ASIL levels) -->
  <!-- ============================================= -->
  
  <rootBlocks xmi:id="_SCB_01" 
    name="Long_Range_Radar" 
    blockType="SENSOR"
    safetyCriticality="CRITICAL"
    asilLevel="ASIL_D"
    hasRedundancy="true"
    redundancyType="HOT_REDUNDANCY"
    description="77 GHz frequency-modulated continuous-wave (FMCW) radar detecting vehicles up to 200m ahead. Provides range, velocity, and azimuth angle measurements.">
    
    <failureModes xmi:id="_FM_001" 
      name="Signal_Processing_Unit_Malfunction"
      failureRate="0.0008"
      failureEffect="Complete loss of radar object detection. No range, velocity, or azimuth data available to sensor fusion."/>
    
    <failureModes xmi:id="_FM_002" 
      name="Antenna_Misalignment"
      failureRate="0.0003"
      failureEffect="Reduced detection range (200m to 120m). Azimuth angle errors causing lateral position inaccuracies."/>
  </rootBlocks>
  
  <rootBlocks xmi:id="_SCB_02" 
    name="Camera_Vision_Sensor" 
    blockType="SENSOR"
    safetyCriticality="HIGH"
    asilLevel="ASIL_B"
    hasRedundancy="true"
    redundancyType="DIVERSIFIED"
    description="Forward-facing camera (1280x720, 60fps) for object classification and lane detection. Complements radar with visual confirmation.">
    
    <failureModes xmi:id="_FM_003" 
      name="Lens_Flare_Saturation"
      failureRate="0.015"
      failureEffect="Temporary blindness of camera sensor. Unable to classify objects in affected image region. Auto-exposure recovery takes 1-3 seconds."/>
    
    <failureModes xmi:id="_FM_004" 
      name="Image_Sensor_Pixel_Defects"
      failureRate="0.0005"
      failureEffect="Hot pixels or dead pixels in image. Usually less than 0.1% of sensor area affected. Detection algorithms compensate via pixel interpolation."/>
  </rootBlocks>
  
  <rootBlocks xmi:id="_SCB_03" 
    name="Vehicle_Speed_Sensor" 
    blockType="SENSOR"
    safetyCriticality="HIGH"
    asilLevel="ASIL_C"
    hasRedundancy="true"
    redundancyType="HOT_REDUNDANCY"
    description="Wheel speed sensor providing ego vehicle velocity. Critical for accurate distance control calculations.">
    
    <failureModes xmi:id="_FM_005" 
      name="Sensor_Electrical_Failure"
      failureRate="0.0004"
      failureEffect="No velocity data. ACC unable to determine ego speed, resulting in system deactivation."/>
  </rootBlocks>
  
  <rootBlocks xmi:id="_SCB_04" 
    name="Sensor_Fusion_Controller" 
    blockType="PROCESSING_UNIT"
    safetyCriticality="CRITICAL"
    asilLevel="ASIL_D"
    hasRedundancy="true"
    redundancyType="TMR"
    description="Central fusion algorithm combining radar and camera data. Implements Kalman filter for object tracking. Dual-core ARM Cortex-R52, 20 Hz processing.">
    
    <failureModes xmi:id="_FM_006" 
      name="Processor_Lockup"
      failureRate="0.0002"
      failureEffect="Complete halt of sensor fusion processing. No object tracks generated. System frozen in last state."/>
    
    <failureModes xmi:id="_FM_007" 
      name="Memory_Corruption_RAM"
      failureRate="0.0001"
      failureEffect="Corruption of object track data structures or state variables. Unpredictable behavior ranging from benign to critical incorrect TTC calculation."/>
    
    <failureModes xmi:id="_FM_008" 
      name="Kalman_Filter_Divergence"
      failureRate="0.0002"
      failureEffect="Fusion algorithm produces unreliable object tracks with high uncertainty. Position estimates oscillate."/>
  </rootBlocks>
  
  <rootBlocks xmi:id="_SCB_05" 
    name="Object_Detection_Module" 
    blockType="PROCESSING_UNIT"
    safetyCriticality="HIGH"
    asilLevel="ASIL_C"
    hasRedundancy="false"
    description="Identifies and classifies objects (car, truck, motorcycle) from fused sensor data. Maintains object track lists.">
    
    <failureModes xmi:id="_FM_009" 
      name="Misclassification_Error"
      failureRate="0.005"
      failureEffect="Large truck misclassified as passenger car, leading to inappropriate following distance."/>
  </rootBlocks>
  
  <rootBlocks xmi:id="_SCB_06" 
    name="Distance_Estimation_Module" 
    blockType="PROCESSING_UNIT"
    safetyCriticality="CRITICAL"
    asilLevel="ASIL_D"
    hasRedundancy="true"
    redundancyType="COLD_REDUNDANCY"
    description="Calculates inter-vehicular distance and validates against time-gap policy (1.8s default). Accounts for road gradient and curve radius.">
    
    <failureModes xmi:id="_FM_010" 
      name="Distance_Calculation_Overflow"
      failureRate="0.0001"
      failureEffect="Distance value wraps around to near-zero due to integer overflow when target vehicle over 250m away."/>
    
    <failureModes xmi:id="_FM_011" 
      name="Gradient_Compensation_Error"
      failureRate="0.001"
      failureEffect="Incorrect distance on steep grades, leading to too close following."/>
  </rootBlocks>
  
  <rootBlocks xmi:id="_SCB_07" 
    name="TTC_Calculator" 
    blockType="PROCESSING_UNIT"
    safetyCriticality="CRITICAL"
    asilLevel="ASIL_D"
    hasRedundancy="false"
    description="Computes Time-To-Collision metric. Triggers emergency braking if TTC less than 0.8s with high confidence. Formula: TTC = distance / relative_velocity.">
    
    <failureModes xmi:id="_FM_012" 
      name="Division_By_Zero"
      failureRate="0.0003"
      failureEffect="TTC calculation fails when relative velocity is exactly zero, causing TTC equals infinity."/>
  </rootBlocks>
  
  <rootBlocks xmi:id="_SCB_08" 
    name="Speed_Control_Arbiter" 
    blockType="CONTROLLER"
    safetyCriticality="CRITICAL"
    asilLevel="ASIL_D"
    hasRedundancy="true"
    redundancyType="HOT_REDUNDANCY"
    description="Arbitrates between cruise control, adaptive following, and emergency braking requests. Ensures safe acceleration limits. Max decel: -6 m/s², max accel: +2 m/s².">
    
    <failureModes xmi:id="_FM_013" 
      name="Arbiter_Deadlock"
      failureRate="0.0001"
      failureEffect="Control arbiter freezes, unable to process new commands. Last issued throttle/brake command continues indefinitely."/>
    
    <failureModes xmi:id="_FM_014" 
      name="Priority_Inversion"
      failureRate="0.0002"
      failureEffect="Emergency brake request blocked by lower priority cruise request. Delayed braking response."/>
  </rootBlocks>
  
  <rootBlocks xmi:id="_SCB_09" 
    name="Diagnostics_Monitor" 
    blockType="PROCESSING_UNIT"
    safetyCriticality="MEDIUM"
    asilLevel="ASIL_B"
    hasRedundancy="false"
    description="Continuous health monitoring using Built-In Self-Test (BIST). Detects sensor degradation, processor faults, and communication errors.">
    
    <failureModes xmi:id="_FM_015" 
      name="False_Negative_Fault"
      failureRate="0.001"
      failureEffect="Actual fault not detected, allowing system to continue operating in degraded state."/>
  </rootBlocks>
  
  <rootBlocks xmi:id="_SCB_10" 
    name="Throttle_Control_Interface" 
    blockType="ACTUATOR"
    safetyCriticality="HIGH"
    asilLevel="ASIL_C"
    hasRedundancy="false"
    description="Sends throttle position commands to engine ECU via CAN. Includes torque request validation and plausibility checks.">
    
    <failureModes xmi:id="_FM_016" 
      name="Throttle_Stuck_Maximum"
      failureRate="0.0002"
      failureEffect="Throttle command register corrupted to 0xFF (100% throttle). Interface continuously sends full throttle command."/>
  </rootBlocks>
  
  <rootBlocks xmi:id="_SCB_11" 
    name="Brake_Control_Interface" 
    blockType="ACTUATOR"
    safetyCriticality="CRITICAL"
    asilLevel="ASIL_D"
    hasRedundancy="true"
    redundancyType="HOT_REDUNDANCY"
    description="Commands hydraulic brake system via electronic brake control. Implements gradual and emergency braking profiles. Max brake pressure: 120 bar, response time: less than 150 ms.">
    
    <failureModes xmi:id="_FM_017" 
      name="Brake_Communication_Timeout"
      failureRate="0.0003"
      failureEffect="Brake command not received by brake ECU. No braking occurs despite ACC request."/>
    
    <failureModes xmi:id="_FM_018" 
      name="Pressure_Limiting_Error"
      failureRate="0.0001"
      failureEffect="Brake pressure capped at 60 bar instead of 120 bar. Insufficient braking force, longer stopping distances."/>
  </rootBlocks>
  
  <rootBlocks xmi:id="_SCB_12" 
    name="Audible_Warning_System" 
    blockType="USER_INTERFACE"
    safetyCriticality="MEDIUM"
    asilLevel="ASIL_B"
    hasRedundancy="false"
    description="Provides audible alerts for imminent collision, system degradation, and driver takeover requests. Alert types: Beep, Chime, Voice.">
    
    <failureModes xmi:id="_FM_019" 
      name="Speaker_Failure"
      failureRate="0.002"
      failureEffect="No audible warning issued. Driver unaware of critical situation."/>
  </rootBlocks>
  
  <rootBlocks xmi:id="_SCB_13" 
    name="Power_Supply_Monitor" 
    blockType="POWER_SUPPLY"
    safetyCriticality="MEDIUM"
    asilLevel="ASIL_B"
    hasRedundancy="false"
    description="Monitors 12V supply voltage and current. Triggers safe shutdown on undervoltage/overvoltage conditions. Operating range: 9-16V.">
    
    <failureModes xmi:id="_FM_020" 
      name="Voltage_Monitoring_Failure"
      failureRate="0.0005"
      failureEffect="Undervoltage not detected. System continues operating with insufficient power, causing erratic behavior."/>
  </rootBlocks>
  
  <rootBlocks xmi:id="_SCB_14" 
    name="Watchdog_Timer" 
    blockType="PROCESSING_UNIT"
    safetyCriticality="CRITICAL"
    asilLevel="ASIL_D"
    hasRedundancy="false"
    description="Independent timer monitoring sensor fusion controller execution. Resets system if timeout exceeds 200ms.">
    
    <failureModes xmi:id="_FM_021" 
      name="Watchdog_IC_Failure"
      failureRate="0.0001"
      failureEffect="Watchdog timer itself fails, allowing undetected processor lockup in sensor fusion controller."/>
  </rootBlocks>
  
