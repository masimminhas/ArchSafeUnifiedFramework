  <!-- ============================================= -->
  <!-- INTEGRATED HAZARDS (15 with S/E/C values) -->
  <!-- ============================================= -->
  
  <globalHazards xmi:id="_HAZ_01"
    name="Unintended_Acceleration"
    riskLevel="CATASTROPHIC"
    hazardCategory="UNINTENDED_FUNCTION"
    severityClass="3"
    exposureClass="4"
    controllabilityClass="3"
    mitigationStatus="FULLY_MITIGATED"
    description="ACC system commands full throttle without driver input, potentially causing rear-end collision or loss of vehicle control. ISO 26262: S3/E4/C3 results in ASIL D."
    severityJustification="Uncontrolled acceleration at highway speeds can lead to fatal collisions with stopped or slow-moving traffic. Severity S3 (life-threatening injuries) per ISO 26262-3 Table 1.">
    <relatedBlocks xmi:idref="_SCB_08"/>
    <relatedBlocks xmi:idref="_SCB_10"/>
    <relatedBlocks xmi:idref="_SCB_04"/>
  </globalHazards>
  
  <globalHazards xmi:id="_HAZ_02"
    name="Failure_To_Brake_Stationary_Object"
    riskLevel="CATASTROPHIC"
    hazardCategory="LOSS_OF_FUNCTION"
    severityClass="3"
    exposureClass="3"
    controllabilityClass="3"
    mitigationStatus="PARTIALLY_MITIGATED"
    description="ACC fails to detect stationary vehicle ahead and does not initiate emergency braking, resulting in high-speed collision. ISO 26262: S3/E3/C3 results in ASIL D."
    severityJustification="High-speed collision with stationary object causes life-threatening injuries. Driver has insufficient reaction time. Severity S3.">
    <relatedBlocks xmi:idref="_SCB_01"/>
    <relatedBlocks xmi:idref="_SCB_02"/>
    <relatedBlocks xmi:idref="_SCB_04"/>
    <relatedBlocks xmi:idref="_SCB_07"/>
    <relatedBlocks xmi:idref="_SCB_11"/>
  </globalHazards>
  
  <globalHazards xmi:id="_HAZ_03"
    name="Incorrect_Distance_Calculation"
    riskLevel="CRITICAL_RISK"
    hazardCategory="ERRONEOUS_OUTPUT"
    severityClass="2"
    exposureClass="4"
    controllabilityClass="2"
    mitigationStatus="FULLY_MITIGATED"
    description="Distance estimation module reports incorrect inter-vehicular distance (too large), causing ACC to follow too closely. ISO 26262: S2/E4/C2 results in ASIL C."
    severityJustification="Severe injuries possible from close following and insufficient braking distance. Severity S2 per ISO 26262-3.">
    <relatedBlocks xmi:idref="_SCB_06"/>
    <relatedBlocks xmi:idref="_SCB_04"/>
