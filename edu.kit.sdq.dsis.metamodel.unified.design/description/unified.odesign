            <style xsi:type="style:SquareDescription" labelSize="11" showIcon="false" labelExpression="aql:'Total Hazards: ' + self.globalHazards->size().toString()" labelPosition="node" resizeKind="NSEW" width="20" height="3">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
