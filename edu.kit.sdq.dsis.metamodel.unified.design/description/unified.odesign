<?xml version="1.0" encoding="UTF-8"?>
<description:Group xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:description="http://www.eclipse.org/sirius/description/1.1.0" xmlns:description_1="http://www.eclipse.org/sirius/diagram/description/1.1.0" xmlns:description_2="http://www.eclipse.org/sirius/table/description/1.1.0" xmlns:style="http://www.eclipse.org/sirius/diagram/description/style/1.1.0" xmlns:tool="http://www.eclipse.org/sirius/diagram/description/tool/1.1.0" xmlns:tool_1="http://www.eclipse.org/sirius/description/tool/1.1.0" xmlns:validation="http://www.eclipse.org/sirius/description/validation/1.1.0" name="unified" version="12.0.0.2017041100">
  <ownedViewpoints name="UnifiedModeling" modelFileExtension="unified">
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="ArchitectureDiagram" domainClass="unified::UnifiedSystemModel" enablePopupBars="true">
      <metamodel href="http://edu.kit.sdq.dsis.metamodel/unified#/"/>
      <validationSet name="architectureValidation">
        <ownedRules xsi:type="validation:SemanticValidationRule" name="BlockNameRequired" level="WARNING" message="Block name should be defined for better traceability." targetClass="unified::SystemBlock">
          <audits auditExpression="aql:self.name != null and self.name.trim().size() > 0"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="ConnectionTypeDefined" level="WARNING" message="Connection type should be specified." targetClass="unified::BlockConnection">
          <audits auditExpression="aql:self.connectionType != null"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="CriticalBlockMustHaveHazards" level="ERROR" message="Safety Critical Block must have associated hazards." targetClass="unified::SafetyCriticalBlock">
          <audits auditExpression="service:hasAssociatedHazards"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="HighCriticalityRequiresFMEA" level="ERROR" message="High Criticality block requires FMEA Analysis." targetClass="unified::SafetyCriticalBlock">
          <audits auditExpression="service:requiresFMEAValidation()"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="BlockHasConnections" message="Isolated blocks may indicate incomplete architecture." targetClass="unified::SystemBlock">
          <audits auditExpression="aql:self.connectionAsSource->size() > 0 or self.connectionAsTarget->size() > 0"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="ASILDRequires80PercentFMEA" level="ERROR" message="ASIL D blocks require 80% FMEA coverage of failure modes." targetClass="unified::SafetyCriticalBlock">
          <audits auditExpression="service:asilDHasFMEACoverage"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="NoCircularDependencies" level="ERROR" message="Circular dependency detected. This block is part of a cycle that could cause architectural issues." targetClass="unified::SystemBlock">
          <audits auditExpression="service:checkCircularDependency"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="BlocksShouldBeConnected" message="This block has no connections. Isolated blocks may indicate incomplete architecture design." targetClass="unified::SystemBlock">
          <audits auditExpression="aql:self.connectionAsSource->size() > 0 or self.connectionAsTarget->size() > 0"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="BlockNameMustBeUnique" level="ERROR" message="Block name must be unique across the model. Duplicate names can cause confusion and traceability issues." targetClass="unified::SystemBlock">
          <audits auditExpression="service:hasUniqueName"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="ModelTraceabilityAdequate" level="WARNING" message="Model traceability density is below 30%. Consider adding more links between architecture and safety elements." targetClass="unified::UnifiedSystemModel">
          <audits auditExpression="service:checkTraceabilityCompleteness"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="CriticalBlockRequiresRedundancy" level="ERROR" message="CRITICAL safety blocks must have redundancy mechanisms defined." targetClass="unified::SafetyCriticalBlock">
          <audits auditExpression="service:highCriticalityHasRedundancy"/>
        </ownedRules>
      </validationSet>
      <defaultLayer name="ArchitectureLayer">
        <nodeMappings name="AD_SystemBlock_Node" semanticCandidatesExpression="feature:systemBlocks" domainClass="unified::SystemBlock">
          <style xsi:type="style:SquareDescription" labelSize="10" showIcon="false" labelPosition="node" resizeKind="NSEW" width="14" height="6">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelFormat>bold</labelFormat>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_blue']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="AD_SafetyCriticalBlock_Node" semanticCandidatesExpression="feature:rootBlocks" domainClass="unified::SafetyCriticalBlock">
          <style xsi:type="style:SquareDescription" borderSizeComputationExpression="2" labelSize="10" showIcon="false" labelPosition="node" resizeKind="NSEW" width="14" height="6">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
            <labelFormat>bold</labelFormat>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_yellow']"/>
          </style>
        </nodeMappings>
        <edgeMappings name="AD_BlockConnection_Edge" semanticCandidatesExpression="aql:self.blockConnections" sourceMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='ArchitectureDiagram']/@defaultLayer/@nodeMappings[name='AD_SafetyCriticalBlock_Node'] //@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='ArchitectureDiagram']/@defaultLayer/@nodeMappings[name='AD_SystemBlock_Node']" targetMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='ArchitectureDiagram']/@defaultLayer/@nodeMappings[name='AD_SafetyCriticalBlock_Node'] //@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='ArchitectureDiagram']/@defaultLayer/@nodeMappings[name='AD_SystemBlock_Node']" targetFinderExpression="aql:self.toBlock" sourceFinderExpression="aql:self.fromBlock" domainClass="unified::BlockConnection" useDomainElement="true">
          <style targetArrow="InputFillClosedArrow" sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <centerLabelStyleDescription showIcon="false" labelExpression="aql:self.connectionType.toString()">
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <edgeMappings name="AD_BlockAssociation_Edge" semanticCandidatesExpression="aql:self.blockAssociations" sourceMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='ArchitectureDiagram']/@defaultLayer/@nodeMappings[name='AD_SafetyCriticalBlock_Node'] //@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='ArchitectureDiagram']/@defaultLayer/@nodeMappings[name='AD_SystemBlock_Node']" targetMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='ArchitectureDiagram']/@defaultLayer/@nodeMappings[name='AD_SafetyCriticalBlock_Node'] //@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='ArchitectureDiagram']/@defaultLayer/@nodeMappings[name='AD_SystemBlock_Node']" targetFinderExpression="aql:self.targetBlock" sourceFinderExpression="aql:self.sourceBlock" domainClass="unified::BlockAssociation" useDomainElement="true">
          <style lineStyle="dash" targetArrow="InputArrowWithDiamond" sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_blue']"/>
            <centerLabelStyleDescription showIcon="false" labelExpression="aql:self.associationType.toString()">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_blue']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <toolSections name="ArchitectureModeling">
          <ownedTools xsi:type="tool:NodeCreationDescription" name="AD_Create_SystemBlock" label="System Block" nodeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='ArchitectureDiagram']/@defaultLayer/@nodeMappings[name='AD_SystemBlock_Node']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::SystemBlock" referenceName="systemBlocks" variableName="newBlock">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'SystemBlock_' + (container.systemBlocks->size() + 1)"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="blockType" valueExpression="aql: unified::BlockType::PROCESSING_UNIT"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:NodeCreationDescription" name="AD_Create_SafetyCriticalBlock" label="Safety Critical Block" nodeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='ArchitectureDiagram']/@defaultLayer/@nodeMappings[name='AD_SafetyCriticalBlock_Node']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::SafetyCriticalBlock" referenceName="rootBlocks" variableName="newBlock">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'SafetyBlock_' + (container.rootBlocks->size() + 1)"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="safetyCriticality" valueExpression="aql:unified::SafetyCriticalityLevel::HIGH"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="asilLevel" valueExpression="aql:unified::ASILLevel::ASIL_B"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="AD_Create_BlockConnection" label="Block Connection" edgeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='ArchitectureDiagram']/@defaultLayer/@edgeMappings[name='AD_BlockConnection_Edge']">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:source.eContainer()">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::BlockConnection" referenceName="blockConnections" variableName="newConnection">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="fromBlock" valueExpression="var:source"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="toBlock" valueExpression="var:target"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="connectionType" valueExpression="aql:unified::ConnectionType::DATA_FLOW"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:source.name + '_to_' + target.name"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="AD_Create_BlockAssociation" label="Block Association" edgeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='ArchitectureDiagram']/@defaultLayer/@edgeMappings[name='AD_BlockAssociation_Edge']">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:source.eContainer()">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::BlockAssociation" referenceName="blockAssociations" variableName="newAssociation">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="sourceBlock" valueExpression="var:source"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="targetBlock" valueExpression="var:target"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="associationType" valueExpression="aql:unified::AssociationType::DEPENDENCY"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:source.name + '_assoc_' + target.name"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
        </toolSections>
        <toolSections name="AnalysisTools" label="Analysis">
          <ownedTools xsi:type="tool_1:OperationAction" name="ValidateConsistency" precondition="aql:true" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/validate.gif">
            <view name="views"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
                <subModelOperations xsi:type="tool_1:ExternalJavaAction" name="Validate" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/validate.gif" id="edu.kit.sdq.dsis.unified.design.actions.ValidateConsistencyAction"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:OperationAction" name="ComputeMetrics" label="Compute Model Metrics" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/metrics.gif">
            <view name="views"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
                <subModelOperations xsi:type="tool_1:ExternalJavaAction" name="ComputeMetrics" id="edu.kit.sdq.dsis.unified.design.actions.MetricsAction"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:OperationAction" name="ExportMetricReport" label="Export Metrics Report " precondition="aql:true" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/export.gif">
            <view name="views"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
                <subModelOperations xsi:type="tool_1:ExternalJavaAction" name="ExportMetricsReport" id="edu.kit.sdq.dsis.unified.design.actions.ExportDetailedMetricsAction"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:OperationAction" name="BlockAnalysisMenu" label="Block Analysis" precondition="aql:true" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/analyze.gif">
            <view name="views"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
                <subModelOperations xsi:type="tool_1:ExternalJavaAction" name="BlockAnalysisMenu" label="Block Analysis" id="edu.kit.sdq.dsis.unified.design.actions.ImpactAnalysisAction"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:OperationAction" name="ExportArchitecture" label="Export Architecture" precondition="aql:true" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/export-architecture.gif">
            <view name="views"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
                <subModelOperations xsi:type="tool_1:ExternalJavaAction" name="ExportArchitecture" label="Export Architecture" id="edu.kit.sdq.dsis.unified.design.actions.ExportArchitectureAction"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:OperationAction" name="ValidateConsistency" label="Validate Consistency" precondition="aql:true">
    <view name="views"/>
    <initialOperation>
      <firstModelOperations xsi:type="tool_1:ExternalJavaAction" name="ValidateConsistency" id="edu.kit.sdq.dsis.unified.design.actions.ValidateConsistencyAction">
                <parameters name="views" value="var:views"/>
              </firstModelOperations>
    </initialOperation>
  </ownedTools>
        </toolSections>
      </defaultLayer>
    </ownedRepresentations>
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="SafetyDiagram" domainClass="unified::UnifiedSystemModel" enablePopupBars="true">
      <metamodel href="http://edu.kit.sdq.dsis.metamodel/unified#/"/>
      <validationSet name="safetyValidation">
        <ownedRules xsi:type="validation:SemanticValidationRule" name="SafetyBlockNameRequired" level="ERROR" message="Safety critical block name must be defined." targetClass="unified::SafetyCriticalBlock">
          <audits auditExpression="aql:self.name != null and self.name.trim().size() > 0"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="HazardNameRequired" level="ERROR" message="Hazard must have a descriptive name." targetClass="unified::IntegratedHazard">
          <audits auditExpression="aql:self.name != null and self.name.trim().size() > 0"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="HazardHasRelatedBlocks" level="WARNING" message="Hazard should be linked to at least one safety-critical block." targetClass="unified::IntegratedHazard">
          <audits auditExpression="aql:self.relatedBlocks->size() > 0"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="FailureModeHasEffect" level="WARNING" message="Failure mode should describe its effect." targetClass="unified::BlockFailureMode">
          <audits auditExpression="aql:self.failureEffect != null and self.failureEffect.size() > 0"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="CriticalHazardMustBeMitigated" level="ERROR" message="Catastrophic hazards must have mitigation strategy." targetClass="unified::IntegratedHazard">
          <audits auditExpression="aql:self.riskLevel &lt;> unified::RiskLevel::CATASTROPHIC or self.mitigationStatus &lt;> unified::MitigationStatus::NOT_MITIGATED"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="FailureModeHasProperDescription" level="WARNING" message="Failure mode description should be at least 5 characters for clarity and traceability." targetClass="unified::BlockFailureMode">
          <audits auditExpression="service:hasProperDescription"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="ASILLevelDefined" level="WARNING" message="Safety-critical blocks should have an ASIL level defined for automotive compliance." targetClass="unified::SafetyCriticalBlock">
          <audits auditExpression="aql:self.asilLevel> unified::ASILLevel::QM and self.asilLevel != null"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="CriticalHazardsMustBeMitigated" level="ERROR" message="Critical and catastrophic hazards must have defined mitigation strategies and be linked to safety mechanisms." targetClass="unified::IntegratedHazard">
          <audits auditExpression="service:criticalHazardHasMitigation"/>
        </ownedRules>
      </validationSet>
      <defaultLayer name="SafetyLayer">
        <nodeMappings name="SD_IntegratedHazard_Node" semanticCandidatesExpression="feature:globalHazards" domainClass="unified::IntegratedHazard">
          <style xsi:type="style:SquareDescription" borderSizeComputationExpression="2" showIcon="false" labelExpression="aql:self.name + ' [' + self.riskLevel.toString() + ']'" iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/IntegratedHazard.png" labelPosition="node" resizeKind="NSEW" width="12" height="5">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelFormat>bold</labelFormat>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
          </style>
        </nodeMappings>
<!-- PASTE THIS TO REPLACE LINE 223 in unified.odesign -->

<!-- PASTE THIS TO REPLACE LINE 223 in unified.odesign -->

<edgeMappings name="SD_HazardToBlock_Edge" 
    semanticCandidatesExpression="aql:self.globalHazards"
    sourceMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='SafetyDiagram']/@defaultLayer/@nodeMappings[name='SD_IntegratedHazard_Node']" 
    targetMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='SafetyDiagram']/@defaultLayer/@containerMappings[name='SD_SafetyCriticalBlock_Container']" 
    targetFinderExpression="aql:self.relatedBlocks"
    sourceFinderExpression="aql:self"
    domainClass="unified::IntegratedHazard"
    useDomainElement="true">
  <style lineStyle="dash_dot" targetArrow="InputClosedArrow" sizeComputationExpression="2">
    <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
    <centerLabelStyleDescription labelSize="9" showIcon="false" labelExpression="threatens">
      <labelFormat>bold</labelFormat>
      <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
    </centerLabelStyleDescription>
  </style>
</edgeMappings>
<!-- CORRECTED Safety Diagram Section -->
<!-- Replace lines 232-342 in your odesign -->

<containerMappings name="SD_SafetyCriticalBlock_Container" semanticCandidatesExpression="feature:rootBlocks" domainClass="unified::SafetyCriticalBlock" childrenPresentation="List">
  <subNodeMappings name="SD_BlockFailureMode_ListItem" semanticCandidatesExpression="feature:failureModes" domainClass="unified::BlockFailureMode">
    <style xsi:type="style:SquareDescription" labelSize="9" showIcon="false" labelExpression="aql:'  ► ' + self.name + ' [λ=' + self.failureRate.toString() + ']'" labelAlignment="LEFT" labelPosition="node" resizeKind="NSEW" height="2">
      <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_gray']"/>
      <labelFormat>italic</labelFormat>
      <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
      <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
    </style>
  </subNodeMappings>
  <style xsi:type="style:FlatContainerStyleDescription" borderSizeComputationExpression="2" labelSize="10" showIcon="false" roundedCorner="true" arcWidth="8" arcHeight="8" labelExpression="aql:self.name + ' [' + self.asilLevel.toString() + '] [' + self.failureModes->size().toString() + ' FMs]'" labelAlignment="CENTER" widthComputationExpression="20" heightComputationExpression="aql:4 + self.failureModes->size() * 2">
    <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
    <labelFormat>bold</labelFormat>
    <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
    <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
    <foregroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_yellow']"/>
  </style>
</containerMappings>

<toolSections name="SafetyTools" label="Safety Analysis Tools">
  <ownedTools xsi:type="tool:ContainerCreationDescription" name="SD_Create_SafetyCriticalBlock" label="Safety Critical Block" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/safety-mechanism.gif" containerMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='SafetyDiagram']/@defaultLayer/@containerMappings[name='SD_SafetyCriticalBlock_Container']">
    <variable name="container"/>
    <viewVariable name="containerView"/>
    <initialOperation>
      <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
        <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::SafetyCriticalBlock" referenceName="rootBlocks" variableName="newBlock">
          <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'SafetyBlock_' + (container.rootBlocks->size() + 1)"/>
          <subModelOperations xsi:type="tool_1:SetValue" featureName="safetyCriticality" valueExpression="aql:unified::SafetyCriticalityLevel::HIGH"/>
          <subModelOperations xsi:type="tool_1:SetValue" featureName="asilLevel" valueExpression="aql:unified::ASILLevel::ASIL_B"/>
          <subModelOperations xsi:type="tool_1:SetValue" featureName="hasRedundancy" valueExpression="false"/>
        </subModelOperations>
      </firstModelOperations>
    </initialOperation>
  </ownedTools>
  
  <ownedTools xsi:type="tool:NodeCreationDescription" name="SD_Create_IntegratedHazard" label="Integrated Hazard" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/hazard.gif" nodeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='SafetyDiagram']/@defaultLayer/@nodeMappings[name='SD_IntegratedHazard_Node']">
    <variable name="container"/>
    <viewVariable name="containerView"/>
    <initialOperation>
      <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
        <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::IntegratedHazard" referenceName="globalHazards" variableName="newHazard">
          <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'Hazard_' + (container.globalHazards->size() + 1)"/>
          <subModelOperations xsi:type="tool_1:SetValue" featureName="riskLevel" valueExpression="aql:unified::RiskLevel::CRITICAL_RISK"/>
          <subModelOperations xsi:type="tool_1:SetValue" featureName="mitigationStatus" valueExpression="aql:unified::MitigationStatus::NOT_MITIGATED"/>
          <subModelOperations xsi:type="tool_1:SetValue" featureName="hazardCategory" valueExpression="aql:unified::HazardCategory::FUNCTIONAL_FAILURE"/>
        </subModelOperations>
      </firstModelOperations>
    </initialOperation>
  </ownedTools>
  
  <ownedTools xsi:type="tool:NodeCreationDescription" name="SD_Create_FailureMode" label="Failure Mode" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/link-failure.gif" nodeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='SafetyDiagram']/@defaultLayer/@containerMappings[name='SD_SafetyCriticalBlock_Container']/@subNodeMappings[name='SD_BlockFailureMode_ListItem']">
    <variable name="container"/>
    <viewVariable name="containerView"/>
    <initialOperation>
      <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
        <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::BlockFailureMode" referenceName="failureModes" variableName="newFailureMode">
          <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'FM_' + (container.failureModes->size() + 1)"/>
          <subModelOperations xsi:type="tool_1:SetValue" featureName="failureRate" valueExpression="0.001"/>
          <subModelOperations xsi:type="tool_1:SetValue" featureName="failureEffect" valueExpression="Describe the effect of this failure mode"/>
        </subModelOperations>
      </firstModelOperations>
    </initialOperation>
  </ownedTools>
  
  <ownedTools xsi:type="tool:EdgeCreationDescription" name="SD_Create_HazardToBlockEdge" label="Hazard to Block Relation" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/link.gif" edgeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='SafetyDiagram']/@defaultLayer/@edgeMappings[name='SD_HazardToBlock_Edge']">
    <sourceVariable name="source"/>
    <targetVariable name="target"/>
    <sourceViewVariable name="sourceView"/>
    <targetViewVariable name="targetView"/>
    <initialOperation>
      <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:source">
        <subModelOperations xsi:type="tool_1:SetValue" featureName="relatedBlocks" valueExpression="aql:self.relatedBlocks->including(target)"/>
      </firstModelOperations>
    </initialOperation>
  </ownedTools>
</toolSections>

<toolSections name="SafetyAnalysisActions" label="🔬 Safety Analysis">
  <ownedTools xsi:type="tool_1:OperationAction" name="ValidateSafety" label="Validate Safety Requirements" precondition="aql:true" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/validate.gif">
    <view name="views"/>
    <initialOperation>
      <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
        <subModelOperations xsi:type="tool_1:ExternalJavaAction" name="ValidateSafetyRequirements" label="Validate Safety Requirements" id="edu.kit.sdq.dsis.unified.design.actions.ValidateConsistencyAction"/>
      </firstModelOperations>
    </initialOperation>
  </ownedTools>
  
  <ownedTools xsi:type="tool_1:OperationAction" name="GenerateFMEAFromSafety" label="Generate FMEA Analysis" precondition="aql:true" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/hazard-analysis.gif">
    <view name="views"/>
    <initialOperation>
      <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
        <subModelOperations xsi:type="tool_1:ExternalJavaAction" name="GenerateFMEAFromSafety" label="Generate FMEA Analysis" id="edu.kit.sdq.dsis.unified.design.actions.GenerateFMEAAction"/>
      </firstModelOperations>
    </initialOperation>
  </ownedTools>
  
  <ownedTools xsi:type="tool_1:OperationAction" name="AnalyzeHazardCoverage" label="Analyze Hazard Coverage" precondition="aql:true" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/coverage.gif">
    <view name="views"/>
    <initialOperation>
      <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:views">
        <subModelOperations xsi:type="tool_1:ExternalJavaAction" name="AnalyzeHazardCoverage" label="Analyze Hazard Coverage" id="edu.kit.sdq.dsis.unified.design.actions.HazardAnalysisAction"/>
      </firstModelOperations>
    </initialOperation>
  </ownedTools>
</toolSections>
      </defaultLayer>
    </ownedRepresentations>
 <ownedRepresentations xsi:type="description_1:DiagramDescription" 
    name="FMEADiagram" 
    domainClass="unified::UnifiedSystemModel" 
    enablePopupBars="true">
  
  <metamodel href="http://edu.kit.sdq.dsis.metamodel/unified#/"/>
  
  <!-- ========================================== -->
  <!-- VALIDATION RULES -->
  <!-- ========================================== -->
  <validationSet name="fmeaValidation">
    
    <ownedRules xsi:type="validation:SemanticValidationRule" 
        name="FMEAItemComplete" 
        level="ERROR" 
        message="FMEA item must have valid S/O/D values (1-10)." 
        targetClass="unified::FMEAItem">
      <audits auditExpression="aql:self.severity >= 1 and self.severity &lt;= 10 and self.occurrence >= 1 and self.occurrence &lt;= 10 and self.detection >= 1 and self.detection &lt;= 10"/>
    </ownedRules>
    
    <ownedRules xsi:type="validation:SemanticValidationRule" 
        name="FMEAItemHasComponent" 
        level="ERROR" 
        message="FMEA item must be linked to a component." 
        targetClass="unified::FMEAItem">
      <audits auditExpression="aql:self.analyzedComponent &lt;> null"/>
    </ownedRules>
    
    <ownedRules xsi:type="validation:SemanticValidationRule" 
        name="FMEAItemHasFailureMode" 
        level="WARNING" 
        message="FMEA item should reference a specific failure mode for precise analysis." 
        targetClass="unified::FMEAItem">
      <audits auditExpression="aql:self.failureMode &lt;> null"/>
    </ownedRules>
    
    <ownedRules xsi:type="validation:SemanticValidationRule" 
        name="HighRPNRequiresMitigation" 
        level="WARNING" 
        message="High RPN (>100) requires mitigation action." 
        targetClass="unified::FMEAItem">
      <audits auditExpression="aql:(self.severity * self.occurrence * self.detection) &lt;= 100 or (self.recommendedAction &lt;> null and self.recommendedAction.size() > 0)"/>
    </ownedRules>
    
    <ownedRules xsi:type="validation:SemanticValidationRule" 
        name="CriticalRPNMustBeAddressed" 
        level="ERROR" 
        message="Critical RPN (>200) must have mitigation action and responsible party assigned." 
        targetClass="unified::FMEAItem">
      <audits auditExpression="aql:(self.severity * self.occurrence * self.detection) &lt;= 200 or (self.recommendedAction &lt;> null and self.recommendedAction.size() > 0 and self.actionStatus &lt;> unified::ActionStatus::OPEN)"/>
    </ownedRules>
    
    <ownedRules xsi:type="validation:SemanticValidationRule" 
        name="AutoGeneratedItemsNeedReview" 
        level="INFO" 
        message="This FMEA item was auto-generated. Please review and refine values." 
        targetClass="unified::FMEAItem">
      <audits auditExpression="aql:not self.autoGenerated"/>
    </ownedRules>
    
    <ownedRules xsi:type="validation:SemanticValidationRule" 
        name="NonSafetyCriticalBlockInFMEA" 
        level="WARNING" 
        message="This FMEA item analyzes a non-safety-critical block. Consider if FMEA analysis is necessary." 
        targetClass="unified::FMEAItem">
      <audits auditExpression="aql:self.analyzedComponent.oclIsKindOf(unified::SafetyCriticalBlock)"/>
    </ownedRules>
    
  </validationSet>
  
  <!-- ========================================== -->
  <!-- DEFAULT LAYER - SAFETY-CRITICAL ONLY -->
  <!-- ========================================== -->
  <defaultLayer name="FMEA_Layer">
    
    <!-- ========================================== -->
    <!-- SAFETY-CRITICAL BLOCKS ONLY (Default View) -->
    <!-- ========================================== -->
    <containerMappings name="FMEA_SafetyCriticalBlock_Container" 
        semanticCandidatesExpression="aql:self.rootBlocks->union(self.systemBlocks)->select(b | b.oclIsKindOf(unified::SafetyCriticalBlock))" 
        domainClass="unified::SafetyCriticalBlock"
        childrenPresentation="List">
      
      <!-- Failure modes as compact list items -->
      <subNodeMappings name="FMEA_BlockFailureMode_ListItem" 
          semanticCandidatesExpression="feature:failureModes" 
          domainClass="unified::BlockFailureMode">
        
        <style xsi:type="style:SquareDescription" 
            labelSize="9" 
            showIcon="false" 
            labelExpression="aql:'  ► ' + self.name + ' [λ=' + self.failureRate.toString() + '/hr]'" 
            labelAlignment="LEFT" 
            labelPosition="node" 
            resizeKind="NSEW" 
            height="3"
            width="20">
          <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_gray']"/>
          <labelFormat>italic</labelFormat>
          <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
          <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
        </style>
      </subNodeMappings>
      
      <!-- Container style with dynamic sizing -->
      <style xsi:type="style:FlatContainerStyleDescription" 
          borderSizeComputationExpression="2" 
          labelSize="11" 
          showIcon="false" 
          roundedCorner="true"
          arcWidth="8"
          arcHeight="8"
          labelExpression="aql:self.name + ' [' + self.asilLevel.toString() + '] - ' + self.failureModes->size().toString() + ' Failure Modes'"
          labelAlignment="CENTER" 
          widthComputationExpression="24" 
          heightComputationExpression="aql:let fmCount = self.failureModes->size() in if fmCount = 0 then 6 else 5 + fmCount * 3 endif">
        <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
        <labelFormat>bold</labelFormat>
        <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_yellow']"/>
        <foregroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
      </style>
    </containerMappings>
    
    <!-- ========================================== -->
    <!-- FMEA ITEMS - Enhanced for Text Visibility -->
    <!-- ========================================== -->
    <nodeMappings name="FMEA_Item_Node" 
        semanticCandidatesExpression="aql:self.fmeaAnalysis.fmeaItems" 
        domainClass="unified::FMEAItem">
      
      <style xsi:type="style:SquareDescription" 
          labelSize="10" 
          showIcon="false" 
          labelExpression="aql:'📋 ' + self.name + '

Component: ' + if self.analyzedComponent = null then '⚠ Not Set' else self.analyzedComponent.name + if not self.analyzedComponent.oclIsKindOf(unified::SafetyCriticalBlock) then ' ⚠ NON-SAFETY' else '' endif endif + '
Failure Mode: ' + if self.failureMode = null then '⚠ Not Set' else self.failureMode.name endif + '

Severity (S): ' + self.severity.toString() + ' | Occurrence (O): ' + self.occurrence.toString() + ' | Detection (D): ' + self.detection.toString() + '

➤ RPN = ' + (self.severity * self.occurrence * self.detection).toString() + if (self.severity * self.occurrence * self.detection) > 100 then ' 🔴 HIGH RISK' else if (self.severity * self.occurrence * self.detection) > 50 then ' 🟠 MEDIUM' else ' 🟢 LOW' endif endif + '

Status: ' + self.actionStatus.toString()" 
          labelAlignment="LEFT"
          labelPosition="node" 
          resizeKind="NSEW"
          width="28" 
          height="16">
        
        <borderColor xsi:type="description:ComputedColor"
            red="aql:if (self.severity * self.occurrence * self.detection) > 100 then 139 else if (self.severity * self.occurrence * self.detection) > 50 then 255 else 34 endif endif"
            green="aql:if (self.severity * self.occurrence * self.detection) > 100 then 0 else if (self.severity * self.occurrence * self.detection) > 50 then 140 else 139 endif endif"
            blue="aql:if (self.severity * self.occurrence * self.detection) > 100 then 0 else if (self.severity * self.occurrence * self.detection) > 50 then 0 else 34 endif endif"/>
        
        <labelFormat>bold</labelFormat>
        <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        
        <!-- RPN-based background color -->
        <color xsi:type="description:ComputedColor"
            red="aql:if (self.severity * self.occurrence * self.detection) > 100 then 255 else if (self.severity * self.occurrence * self.detection) > 50 then 255 else 240 endif endif"
            green="aql:if (self.severity * self.occurrence * self.detection) > 100 then 200 else if (self.severity * self.occurrence * self.detection) > 50 then 245 else 255 endif endif"
            blue="aql:if (self.severity * self.occurrence * self.detection) > 100 then 200 else if (self.severity * self.occurrence * self.detection) > 50 then 220 else 240 endif endif"/>
      </style>
    </nodeMappings>
    
    <!-- ========================================== -->
    <!-- TECHNICAL REQUIREMENTS -->
    <!-- ========================================== -->
    <nodeMappings name="FMEA_TechnicalReq_Node" 
        semanticCandidatesExpression="feature:technicalRequirements" 
        domainClass="unified::TechnicalSafetyRequirement">
      
      <style xsi:type="style:SquareDescription" 
          labelSize="10" 
          showIcon="false" 
          labelExpression="aql:self.requirementId + ': ' + self.name + '
Status: ' + self.status.toString()" 
          labelPosition="node" 
          resizeKind="NSEW" 
          width="16" 
          height="6">
        <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_green']"/>
        <labelFormat>bold</labelFormat>
        <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_green']"/>
      </style>
    </nodeMappings>
    
    <!-- ========================================== -->
    <!-- SAFETY MECHANISMS -->
    <!-- ========================================== -->
    <nodeMappings name="FMEA_SafetyMechanism_Node" 
        semanticCandidatesExpression="feature:safetyMechanisms" 
        domainClass="unified::SafetyMechanism">
      
      <style xsi:type="style:SquareDescription" 
          labelSize="10"
          showIcon="false" 
          labelExpression="aql:self.name + '
Type: ' + self.mechanismType.toString()" 
          labelPosition="node" 
          resizeKind="NSEW" 
          width="14" 
          height="5">
        <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='purple']"/>
        <labelFormat>bold</labelFormat>
        <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_purple']"/>
      </style>
    </nodeMappings>
    
    <!-- ========================================== -->
    <!-- EDGES - Clean Relationship Topology -->
    <!-- ========================================== -->
    
    <!-- Edge 1: FMEA Item → Component Block (Primary Analysis) -->
    <edgeMappings name="FMEA_ItemToComponent_Edge" 
        sourceMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@nodeMappings[name='FMEA_Item_Node']" 
        targetMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@containerMappings[name='FMEA_SafetyCriticalBlock_Container']" 
        targetFinderExpression="aql:self.analyzedComponent"
        reconnections="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@toolSections[name='FMEATools']/@ownedTools[name='FMEA_Reconnect_Component']">
      
      <style targetArrow="InputFillClosedArrow" sizeComputationExpression="2">
        <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='blue']"/>
        <centerLabelStyleDescription labelSize="10" showIcon="false" labelExpression="analyzes">
          <labelFormat>bold</labelFormat>
          <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_blue']"/>
        </centerLabelStyleDescription>
      </style>
    </edgeMappings>
    
    <!-- Edge 2: FMEA Item → Failure Mode (Specific Analysis) -->
    <edgeMappings name="FMEA_ItemToFailureMode_Edge" 
        sourceMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@nodeMappings[name='FMEA_Item_Node']" 
        targetMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@containerMappings[name='FMEA_SafetyCriticalBlock_Container']/@subNodeMappings[name='FMEA_BlockFailureMode_ListItem']" 
        targetFinderExpression="aql:self.failureMode"
        reconnections="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@toolSections[name='FMEATools']/@ownedTools[name='FMEA_Reconnect_FailureMode']">
      
      <style lineStyle="dash" targetArrow="InputArrow" sizeComputationExpression="1">
        <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
        <centerLabelStyleDescription labelSize="9" showIcon="false" labelExpression="relates to">
          <labelFormat>italic</labelFormat>
          <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
        </centerLabelStyleDescription>
      </style>
    </edgeMappings>
    
    <!-- Edge 3: Technical Requirement → FMEA Item (Verification) -->
    <edgeMappings name="FMEA_TechReqToItem_Edge" 
        semanticCandidatesExpression="aql:self.technicalRequirements" 
        sourceMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@nodeMappings[name='FMEA_TechnicalReq_Node']" 
        targetMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@nodeMappings[name='FMEA_Item_Node']" 
        targetFinderExpression="aql:self.verifiedBy" 
        sourceFinderExpression="aql:self" 
        domainClass="unified::TechnicalSafetyRequirement" 
        useDomainElement="true">
      
      <style lineStyle="dash" targetArrow="InputFillClosedArrow" sizeComputationExpression="2">
        <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_green']"/>
        <centerLabelStyleDescription labelSize="9" showIcon="false" labelExpression="verifies">
          <labelFormat>bold</labelFormat>
          <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_green']"/>
        </centerLabelStyleDescription>
      </style>
    </edgeMappings>
    
    <!-- Edge 4: Safety Mechanism → FMEA Item (Validation) -->
    <edgeMappings name="FMEA_MechanismToItem_Edge" 
        semanticCandidatesExpression="aql:self.safetyMechanisms" 
        sourceMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@nodeMappings[name='FMEA_SafetyMechanism_Node']" 
        targetMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@nodeMappings[name='FMEA_Item_Node']" 
        targetFinderExpression="aql:self.validatedBy" 
        sourceFinderExpression="aql:self" 
        domainClass="unified::SafetyMechanism" 
        useDomainElement="true">
      
      <style lineStyle="dot" targetArrow="InputArrow" sizeComputationExpression="2">
        <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='purple']"/>
        <centerLabelStyleDescription labelSize="9" showIcon="false" labelExpression="validates">
          <labelFormat>italic</labelFormat>
          <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='purple']"/>
        </centerLabelStyleDescription>
      </style>
    </edgeMappings>
    
    <!-- ========================================== -->
    <!-- TOOLS -->
    <!-- ========================================== -->
    <toolSections name="FMEATools" label="FMEA Analysis">
      
      <!-- Tool 1: Create FMEA Item -->
      <ownedTools xsi:type="tool:NodeCreationDescription" 
          name="FMEA_Create_Item" 
          label="FMEA Item" 
          nodeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@nodeMappings[name='FMEA_Item_Node']" 
          iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/fmea-item.gif">
        
        <variable name="container"/>
        <viewVariable name="containerView"/>
        
        <initialOperation>
          <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
            <!-- Navigate to FMEA analysis or create if missing -->
            <subModelOperations xsi:type="tool_1:If" conditionExpression="aql:self.fmeaAnalysis->isEmpty()">
              <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::FMEAAnalysis" referenceName="fmeaAnalysis" variableName="newAnalysis">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'FMEA_Analysis_1'"/>
                <subModelOperations xsi:type="tool_1:SetValue" featureName="rpnThreshold" valueExpression="100"/>
              </subModelOperations>
            </subModelOperations>
            
            <!-- Create FMEA item in first analysis -->
            <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self.fmeaAnalysis->first()">
              <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::FMEAItem" referenceName="fmeaItems" variableName="newItem">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'FMEAItem_' + (self.fmeaItems->size() + 1).toString()"/>
                <subModelOperations xsi:type="tool_1:SetValue" featureName="severity" valueExpression="5"/>
                <subModelOperations xsi:type="tool_1:SetValue" featureName="occurrence" valueExpression="3"/>
                <subModelOperations xsi:type="tool_1:SetValue" featureName="detection" valueExpression="4"/>
                <subModelOperations xsi:type="tool_1:SetValue" featureName="actionStatus" valueExpression="aql:unified::ActionStatus::OPEN"/>
                <subModelOperations xsi:type="tool_1:SetValue" featureName="autoGenerated" valueExpression="false"/>
              </subModelOperations>
            </subModelOperations>
          </firstModelOperations>
        </initialOperation>
      </ownedTools>
      
      <!-- Tool 2: Link Item to Component -->
      <ownedTools xsi:type="tool:EdgeCreationDescription" 
          name="FMEA_Link_Item_to_Component" 
          label="Link to Component" 
          edgeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@edgeMappings[name='FMEA_ItemToComponent_Edge']" 
          iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/link-component.gif">
        
        <sourceVariable name="source"/>
        <targetVariable name="target"/>
        <sourceViewVariable name="sourceView"/>
        <targetViewVariable name="targetView"/>
        
        <initialOperation>
          <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:source">
            <subModelOperations xsi:type="tool_1:SetValue" featureName="analyzedComponent" valueExpression="var:target"/>
          </firstModelOperations>
        </initialOperation>
      </ownedTools>
      
      <!-- Tool 3: Link Item to Failure Mode -->
      <ownedTools xsi:type="tool:EdgeCreationDescription" 
          name="FMEA_Link_Item_to_FailureMode" 
          label="Link to Failure Mode" 
          edgeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@edgeMappings[name='FMEA_ItemToFailureMode_Edge']" 
          iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/link-failure.gif">
        
        <sourceVariable name="source"/>
        <targetVariable name="target"/>
        <sourceViewVariable name="sourceView"/>
        <targetViewVariable name="targetView"/>
        
        <initialOperation>
          <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:source">
            <subModelOperations xsi:type="tool_1:SetValue" featureName="failureMode" valueExpression="var:target"/>
          </firstModelOperations>
        </initialOperation>
      </ownedTools>
      
      <!-- Tool 4: Reconnect Component Edge -->
      <ownedTools xsi:type="tool:ReconnectEdgeDescription" 
          name="FMEA_Reconnect_Component">
        <source name="source"/>
        <target name="target"/>
        <sourceView name="sourceView"/>
        <targetView name="targetView"/>
        <element name="element"/>
        <initialOperation>
          <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:element">
            <subModelOperations xsi:type="tool_1:SetValue" featureName="analyzedComponent" valueExpression="var:target"/>
          </firstModelOperations>
        </initialOperation>
      </ownedTools>
      
      <!-- Tool 5: Reconnect Failure Mode Edge -->
      <ownedTools xsi:type="tool:ReconnectEdgeDescription" 
          name="FMEA_Reconnect_FailureMode">
        <source name="source"/>
        <target name="target"/>
        <sourceView name="sourceView"/>
        <targetView name="targetView"/>
        <element name="element"/>
        <initialOperation>
          <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:element">
            <subModelOperations xsi:type="tool_1:SetValue" featureName="failureMode" valueExpression="var:target"/>
          </firstModelOperations>
        </initialOperation>
      </ownedTools>
      
      <!-- Tool 6: Create Technical Requirement -->
      <ownedTools xsi:type="tool:NodeCreationDescription" 
          name="FMEA_Create_TechReq" 
          label="Technical Requirement" 
          nodeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@nodeMappings[name='FMEA_TechnicalReq_Node']" 
          iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/fmea-tech-req.gif">
        
        <variable name="container"/>
        <viewVariable name="containerView"/>
        
        <initialOperation>
          <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
            <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::TechnicalSafetyRequirement" referenceName="technicalRequirements" variableName="newReq">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'TSR_' + (container.technicalRequirements->size() + 1).toString()"/>
              <subModelOperations xsi:type="tool_1:SetValue" featureName="requirementId" valueExpression="aql:'TSR-' + (container.technicalRequirements->size() + 1).toString()"/>
              <subModelOperations xsi:type="tool_1:SetValue" featureName="status" valueExpression="aql:unified::RequirementStatus::DRAFT"/>
            </subModelOperations>
          </firstModelOperations>
        </initialOperation>
      </ownedTools>
      
      <!-- Tool 7: Create Safety Mechanism -->
      <ownedTools xsi:type="tool:NodeCreationDescription" 
          name="FMEA_Create_Mechanism" 
          label="Safety Mechanism" 
          nodeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@nodeMappings[name='FMEA_SafetyMechanism_Node']" 
          iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/fmea-mechanism.gif">
        
        <variable name="container"/>
        <viewVariable name="containerView"/>
        
        <initialOperation>
          <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
            <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::SafetyMechanism" referenceName="safetyMechanisms" variableName="newMech">
              <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'SafetyMech_' + (container.safetyMechanisms->size() + 1).toString()"/>
              <subModelOperations xsi:type="tool_1:SetValue" featureName="mechanismType" valueExpression="aql:unified::SafetyMechanismType::REDUNDANCY"/>
            </subModelOperations>
          </firstModelOperations>
        </initialOperation>
      </ownedTools>
      
      <!-- Tool 8: Link Technical Requirement to FMEA Item -->
      <ownedTools xsi:type="tool:EdgeCreationDescription" 
          name="FMEA_Link_TechReqToItem" 
          label="Link TSR → FMEA (Verification)" 
          edgeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@edgeMappings[name='FMEA_TechReqToItem_Edge']" 
          iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/verification-link.gif">
        
        <sourceVariable name="source"/>
        <targetVariable name="target"/>
        <sourceViewVariable name="sourceView"/>
        <targetViewVariable name="targetView"/>
        
        <initialOperation>
          <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:source">
            <subModelOperations xsi:type="tool_1:SetValue" featureName="verifiedBy" valueExpression="aql:self.verifiedBy->including(target)"/>
          </firstModelOperations>
        </initialOperation>
      </ownedTools>
      
      <!-- Tool 9: Link Safety Mechanism to FMEA Item -->
      <ownedTools xsi:type="tool:EdgeCreationDescription" 
          name="FMEA_Link_MechanismToItem" 
          label="Link Mechanism → FMEA (Validation)" 
          edgeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@edgeMappings[name='FMEA_MechanismToItem_Edge']" 
          iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/validation-link.gif">
        
        <sourceVariable name="source"/>
        <targetVariable name="target"/>
        <sourceViewVariable name="sourceView"/>
        <targetViewVariable name="targetView"/>
        
        <initialOperation>
          <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:source">
            <subModelOperations xsi:type="tool_1:SetValue" featureName="validatedBy" valueExpression="aql:self.validatedBy->including(target)"/>
          </firstModelOperations>
        </initialOperation>
      </ownedTools>
      
    </toolSections>
    
    <!-- ========================================== -->
    <!-- AUTOMATION TOOLS -->
    <!-- ========================================== -->
    <toolSections name="FMEAAutomation" label="Automation and Export">
      
      <ownedTools xsi:type="tool_1:OperationAction" 
          name="ValidateFMEA" 
          label="Validate FMEA Analysis" 
          precondition="aql:true" 
          icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/validate.gif">
        <view name="views"/>
        <initialOperation>
          <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
            <subModelOperations xsi:type="tool_1:ExternalJavaAction" 
                name="ValidateFMEA" 
                id="edu.kit.sdq.dsis.unified.design.actions.ValidateConsistencyAction"/>
          </firstModelOperations>
        </initialOperation>
      </ownedTools>
      
      <ownedTools xsi:type="tool_1:OperationAction" 
          name="GenerateFMEA" 
          label="Auto-Generate FMEA Items" 
          precondition="aql:true" 
          icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/generate.gif">
        <view name="views"/>
        <initialOperation>
          <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
            <subModelOperations xsi:type="tool_1:ExternalJavaAction" 
                name="GenerateFMEAItems" 
                id="edu.kit.sdq.dsis.unified.design.actions.GenerateFMEAAction"/>
          </firstModelOperations>
        </initialOperation>
      </ownedTools>
      
      <ownedTools xsi:type="tool_1:OperationAction" 
          name="ExportFMEAAction" 
          label="Export FMEA Report" 
          precondition="aql:true" 
          icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/export.gif">
        <view name="views"/>
        <initialOperation>
          <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
            <subModelOperations xsi:type="tool_1:ExternalJavaAction" 
                name="ExportFMEAAnalysis" 
                id="edu.kit.sdq.dsis.unified.design.actions.ExportFMEAAction"/>
          </firstModelOperations>
        </initialOperation>
      </ownedTools>
      
    </toolSections>
    
  </defaultLayer>
  
  <!-- ========================================== -->
  <!-- LAYER: ALL COMPONENTS (Including Non-Safety) -->
  <!-- ========================================== -->
  <!-- 
  PURPOSE: Show ALL system blocks, not just safety-critical ones
  Use when you need complete system view or when analyzing
  non-safety-critical components that may still need FMEA
  -->
  <additionalLayers name="FMEA_AllComponents_Layer" 
      label="🔧 Show All Components (Including Non-Safety)" 
      activeByDefault="false">
    
    <!-- Show all SystemBlocks (both safety-critical and regular) -->
    <containerMappings name="FMEA_AllBlocks_Container" 
        semanticCandidatesExpression="aql:self.rootBlocks->union(self.systemBlocks)" 
        domainClass="unified::SystemBlock"
        childrenPresentation="List">
      
      <!-- Failure modes (only for SafetyCriticalBlocks) -->
      <subNodeMappings name="FMEA_AllBlocks_FailureMode_ListItem" 
          semanticCandidatesExpression="aql:if self.oclIsKindOf(unified::SafetyCriticalBlock) then self.oclAsType(unified::SafetyCriticalBlock).failureModes else Sequence{} endif" 
          domainClass="unified::BlockFailureMode">
        
        <style xsi:type="style:SquareDescription" 
            labelSize="9" 
            showIcon="false" 
            labelExpression="aql:'  ► ' + self.name + ' [λ=' + self.failureRate.toString() + '/hr]'" 
            labelAlignment="LEFT" 
            labelPosition="node" 
            resizeKind="NSEW" 
            height="3"
            width="20">
          <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_gray']"/>
          <labelFormat>italic</labelFormat>
          <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
          <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
        </style>
      </subNodeMappings>
      
      <!-- Different styles for safety-critical vs regular blocks -->
      <style xsi:type="style:FlatContainerStyleDescription" 
          borderSizeComputationExpression="2" 
          labelSize="11" 
          showIcon="false" 
          roundedCorner="true"
          arcWidth="8"
          arcHeight="8"
          labelExpression="aql:if self.oclIsKindOf(unified::SafetyCriticalBlock) then self.name + ' [' + self.oclAsType(unified::SafetyCriticalBlock).asilLevel.toString() + '] - ' + self.oclAsType(unified::SafetyCriticalBlock).failureModes->size().toString() + ' FMs' else self.name + ' [Non-Safety]' endif"
          labelAlignment="CENTER" 
          widthComputationExpression="24" 
          heightComputationExpression="aql:if self.oclIsKindOf(unified::SafetyCriticalBlock) then let fmCount = self.oclAsType(unified::SafetyCriticalBlock).failureModes->size() in if fmCount = 0 then 6 else 5 + fmCount * 3 endif else 6 endif">
        
        <!-- Different border colors: Red for safety-critical, Blue for regular -->
        <borderColor xsi:type="description:ComputedColor"
            red="aql:if self.oclIsKindOf(unified::SafetyCriticalBlock) then 139 else 0 endif"
            green="aql:if self.oclIsKindOf(unified::SafetyCriticalBlock) then 0 else 0 endif"
            blue="aql:if self.oclIsKindOf(unified::SafetyCriticalBlock) then 0 else 139 endif"/>
        
        <labelFormat>bold</labelFormat>
        <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        
        <!-- Different backgrounds: Yellow for safety-critical, Light Blue for regular -->
        <backgroundColor xsi:type="description:ComputedColor"
            red="aql:if self.oclIsKindOf(unified::SafetyCriticalBlock) then 255 else 173 endif"
            green="aql:if self.oclIsKindOf(unified::SafetyCriticalBlock) then 255 else 216 endif"
            blue="aql:if self.oclIsKindOf(unified::SafetyCriticalBlock) then 224 else 230 endif"/>
        
        <foregroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
      </style>
    </containerMappings>
    
    <!-- Edge for All Components layer (targets any SystemBlock) -->
    <edgeMappings name="FMEA_ItemToAllComponents_Edge" 
        sourceMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@nodeMappings[name='FMEA_Item_Node']" 
        targetMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@additionalLayers[name='FMEA_AllComponents_Layer']/@containerMappings[name='FMEA_AllBlocks_Container']" 
        targetFinderExpression="aql:self.analyzedComponent">
      
      <style targetArrow="InputFillClosedArrow" sizeComputationExpression="2">
        <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='blue']"/>
        <centerLabelStyleDescription labelSize="10" showIcon="false" labelExpression="analyzes">
          <labelFormat>bold</labelFormat>
          <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_blue']"/>
        </centerLabelStyleDescription>
      </style>
    </edgeMappings>
    
  </additionalLayers>
  
  <!-- ========================================== -->
  <!-- ADDITIONAL LAYERS FOR FILTERING -->
  <!-- ========================================== -->
  
  <!-- Layer: High Risk Items Only (RPN > 100) -->
  <additionalLayers name="FMEA_HighRisk_Layer" 
      label="🔴 High Risk Items (RPN > 100)" 
      activeByDefault="false">
    
    <nodeMappings name="FMEA_HighRisk_Items" 
        semanticCandidatesExpression="aql:self.fmeaAnalysis.fmeaItems->select(item | (item.severity * item.occurrence * item.detection) > 100)" 
        domainClass="unified::FMEAItem">
      
      <style xsi:type="style:SquareDescription" 
          labelSize="11" 
          showIcon="false" 
          labelExpression="aql:'🔴 HIGH RISK: ' + self.name + '

Component: ' + if self.analyzedComponent = null then '⚠ Not Set' else self.analyzedComponent.name endif + '
Failure: ' + if self.failureMode = null then '⚠ Not Set' else self.failureMode.name endif + '

S=' + self.severity.toString() + ' | O=' + self.occurrence.toString() + ' | D=' + self.detection.toString() + '  ➤  RPN=' + (self.severity * self.occurrence * self.detection).toString() + '

Status: ' + self.actionStatus.toString() + '
Mitigation: ' + if self.recommendedAction = null or self.recommendedAction.size() = 0 then '⚠ NOT DEFINED' else 'Defined' endif" 
          labelAlignment="LEFT"
          labelPosition="node" 
          resizeKind="NSEW"
          width="30" 
          height="14">
        
        <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
        <labelFormat>bold</labelFormat>
        <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_red']"/>
      </style>
    </nodeMappings>
    
    <!-- Show related SAFETY-CRITICAL components in this layer -->
    <containerMappings name="FMEA_HighRisk_RelatedBlocks" 
        semanticCandidatesExpression="aql:self.fmeaAnalysis.fmeaItems->select(item | (item.severity * item.occurrence * item.detection) > 100).analyzedComponent->select(b | b.oclIsKindOf(unified::SafetyCriticalBlock))->asSet()" 
        domainClass="unified::SafetyCriticalBlock"
        childrenPresentation="List">
      
      <subNodeMappings name="FMEA_HighRisk_FailureModes" 
          semanticCandidatesExpression="feature:failureModes" 
          domainClass="unified::BlockFailureMode">
        <style xsi:type="style:SquareDescription" 
            labelSize="9" 
            showIcon="false" 
            labelExpression="aql:'  ► ' + self.name" 
            labelAlignment="LEFT" 
            labelPosition="node" 
            resizeKind="NSEW" 
            height="3">
          <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_gray']"/>
          <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
          <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
        </style>
      </subNodeMappings>
      
      <style xsi:type="style:FlatContainerStyleDescription" 
          borderSizeComputationExpression="3" 
          labelSize="11" 
          showIcon="false" 
          labelExpression="aql:self.name + ' [HIGH RISK COMPONENT]'" 
          widthComputationExpression="22" 
          heightComputationExpression="10">
        <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
        <labelFormat>bold</labelFormat>
        <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
        <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_red']"/>
      </style>
    </containerMappings>
    
  </additionalLayers>
  
  <!-- Layer: Open/Pending Items Only -->
  <additionalLayers name="FMEA_Open_Layer" 
      label="📝 Open Items (Action Required)" 
      activeByDefault="false">
    
    <nodeMappings name="FMEA_Open_Items" 
        semanticCandidatesExpression="aql:self.fmeaAnalysis.fmeaItems->select(item | item.actionStatus = unified::ActionStatus::OPEN)" 
        domainClass="unified::FMEAItem">
      
      <style xsi:type="style:SquareDescription" 
          labelSize="10" 
          showIcon="false" 
          labelExpression="aql:'📝 ' + self.name + ' - ACTION REQUIRED

Component: ' + if self.analyzedComponent = null then '⚠ Not Set' else self.analyzedComponent.name endif + '
RPN: ' + (self.severity * self.occurrence * self.detection).toString() + '

Status: OPEN
Next Action: ' + if self.recommendedAction = null or self.recommendedAction.size() = 0 then 'Define mitigation' else self.recommendedAction endif" 
          labelAlignment="LEFT"
          labelPosition="node" 
          resizeKind="NSEW"
          width="26" 
          height="12">
        
        <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='orange']"/>
        <labelFormat>bold</labelFormat>
        <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_orange']"/>
      </style>
    </nodeMappings>
    
  </additionalLayers>
  
  <!-- Layer: By Subsystem/Component (SAFETY-CRITICAL ONLY) -->
  <additionalLayers name="FMEA_ByComponent_Layer" 
      label="🔧 Group by Safety-Critical Component" 
      activeByDefault="false">
    
    <!-- Group FMEA items by their analyzed safety-critical component -->
    <containerMappings name="FMEA_ComponentGroup" 
        semanticCandidatesExpression="aql:self.rootBlocks->union(self.systemBlocks)->select(b | b.oclIsKindOf(unified::SafetyCriticalBlock))" 
        domainClass="unified::SafetyCriticalBlock"
        childrenPresentation="List">
      
      <!-- FMEA items as subnodes -->
      <subNodeMappings name="FMEA_ItemInComponent" 
          semanticCandidatesExpression="aql:self.eContainer().fmeaAnalysis.fmeaItems->select(item | item.analyzedComponent = self)" 
          domainClass="unified::FMEAItem">
        
        <style xsi:type="style:SquareDescription" 
            labelSize="9" 
            showIcon="false" 
            labelExpression="aql:'  • ' + self.name + ' [RPN=' + (self.severity * self.occurrence * self.detection).toString() + ']'" 
            labelAlignment="LEFT" 
            labelPosition="node" 
            height="3">
          <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
          <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
          <color xsi:type="description:ComputedColor"
              red="aql:if (self.severity * self.occurrence * self.detection) > 100 then 255 else 240 endif"
              green="aql:if (self.severity * self.occurrence * self.detection) > 100 then 200 else 255 endif"
              blue="aql:if (self.severity * self.occurrence * self.detection) > 100 then 200 else 240 endif"/>
        </style>
      </subNodeMappings>
      
      <style xsi:type="style:FlatContainerStyleDescription" 
          borderSizeComputationExpression="2" 
          labelSize="11" 
          showIcon="false" 
          labelExpression="aql:self.name + ' [' + self.asilLevel.toString() + '] - ' + self.eContainer().fmeaAnalysis.fmeaItems->select(item | item.analyzedComponent = self)->size().toString() + ' FMEA Items'" 
          widthComputationExpression="24" 
          heightComputationExpression="aql:7 + self.eContainer().fmeaAnalysis.fmeaItems->select(item | item.analyzedComponent = self)->size() * 3">
        <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
        <labelFormat>bold</labelFormat>
        <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_yellow']"/>
      </style>
    </containerMappings>
    
  </additionalLayers>
  
  <!-- Layer: Auto-Generated Items (Need Review) -->
  <additionalLayers name="FMEA_AutoGen_Layer" 
      label="🤖 Auto-Generated Items (Review Required)" 
      activeByDefault="false">
    
    <nodeMappings name="FMEA_AutoGen_Items" 
        semanticCandidatesExpression="aql:self.fmeaAnalysis.fmeaItems->select(item | item.autoGenerated)" 
        domainClass="unified::FMEAItem">
      
      <style xsi:type="style:SquareDescription" 
          labelSize="10" 
          showIcon="false" 
          labelExpression="aql:'🤖 AUTO: ' + self.name + '

⚠ This item was auto-generated - Please review and refine values

Component: ' + if self.analyzedComponent = null then 'Not Set' else self.analyzedComponent.name endif + '
S=' + self.severity.toString() + ' | O=' + self.occurrence.toString() + ' | D=' + self.detection.toString() + '  RPN=' + (self.severity * self.occurrence * self.detection).toString()" 
          labelAlignment="LEFT"
          labelPosition="node" 
          resizeKind="NSEW"
          width="26" 
          height="11">
        
        <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
        <labelFormat>italic</labelFormat>
        <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_gray']"/>
        <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_gray']"/>
      </style>
    </nodeMappings>
    
  </additionalLayers>
  
  <!-- Layer: Safety Goals (Optional Display) -->
  <additionalLayers name="FMEA_SafetyGoals_Layer" 
      label="📋 Show Safety Goals (Traceability)" 
      activeByDefault="false">
    
    <nodeMappings name="FMEA_SafetyGoal_Node" 
        semanticCandidatesExpression="feature:safetyGoals" 
        domainClass="unified::SafetyGoal">
      
      <style xsi:type="style:SquareDescription" 
          labelSize="10"
          showIcon="false" 
          labelExpression="aql:'📋 ' + self.requirementId + ': ' + self.name + '

ASIL: ' + self.asilLevel.toString() + '
Status: ' + self.status.toString() + '

(From Requirements Diagram)'" 
          labelPosition="node" 
          resizeKind="NSEW" 
          width="18" 
          height="8">
        <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
        <labelFormat>bold</labelFormat>
        <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
        <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_yellow']"/>
      </style>
    </nodeMappings>
    
    <!-- Edge: Safety Goal → FMEA Item (Shows Derivation) -->
    <edgeMappings name="FMEA_GoalToItem_Edge" 
        semanticCandidatesExpression="aql:self.safetyGoals" 
        sourceMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@additionalLayers[name='FMEA_SafetyGoals_Layer']/@nodeMappings[name='FMEA_SafetyGoal_Node']" 
        targetMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEADiagram']/@defaultLayer/@nodeMappings[name='FMEA_Item_Node']" 
        targetFinderExpression="aql:self.derivedItems" 
        sourceFinderExpression="aql:self" 
        domainClass="unified::SafetyGoal" 
        useDomainElement="true">
      
      <style lineStyle="dash_dot" sizeComputationExpression="1">
        <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
        <centerLabelStyleDescription labelSize="9" showIcon="false" labelExpression="derives">
          <labelFormat>italic</labelFormat>
          <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
        </centerLabelStyleDescription>
      </style>
    </edgeMappings>
    
  </additionalLayers>
  
  <!-- Layer: Compact View (Overview) -->
  <additionalLayers name="FMEA_Compact_Layer" 
      label="📊 Compact View (Overview)" 
      activeByDefault="false">
    
    <nodeMappings name="FMEA_Item_Compact" 
        semanticCandidatesExpression="aql:self.fmeaAnalysis.fmeaItems" 
        domainClass="unified::FMEAItem">
      
      <style xsi:type="style:SquareDescription" 
          labelSize="9" 
          showIcon="false" 
          labelExpression="aql:self.name + '
RPN: ' + (self.severity * self.occurrence * self.detection).toString() + ' | ' + self.actionStatus.toString()" 
          labelAlignment="CENTER"
          labelPosition="node" 
          resizeKind="NSEW"
          width="16" 
          height="5">
        
        <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        <labelFormat>bold</labelFormat>
        <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        
        <!-- Same RPN-based color coding -->
        <color xsi:type="description:ComputedColor"
            red="aql:if (self.severity * self.occurrence * self.detection) > 100 then 255 else if (self.severity * self.occurrence * self.detection) > 50 then 255 else 240 endif endif"
            green="aql:if (self.severity * self.occurrence * self.detection) > 100 then 200 else if (self.severity * self.occurrence * self.detection) > 50 then 245 else 255 endif endif"
            blue="aql:if (self.severity * self.occurrence * self.detection) > 100 then 200 else if (self.severity * self.occurrence * self.detection) > 50 then 220 else 240 endif endif"/>
      </style>
    </nodeMappings>
    
  </additionalLayers>
  
</ownedRepresentations>
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="TraceabilityDiagram" domainClass="unified::UnifiedSystemModel" enablePopupBars="true">
      <metamodel href="http://edu.kit.sdq.dsis.metamodel/unified#/"/>
      <defaultLayer name="TraceabilityLayer">
        <nodeMappings name="TRACE_SystemBlock_Node" semanticCandidatesExpression="feature:systemBlocks" domainClass="unified::SystemBlock">
          <style xsi:type="style:SquareDescription" labelSize="9" showIcon="false" labelPosition="node" resizeKind="NSEW" width="10" height="5">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='blue']"/>
            <labelFormat>bold</labelFormat>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
