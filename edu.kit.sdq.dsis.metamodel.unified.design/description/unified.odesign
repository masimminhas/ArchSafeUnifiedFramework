              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_yellow']"/>
            </style>
          </subNodeMappings>
          <subNodeMappings name="MTABLE_HazardCoverage" semanticCandidatesExpression="aql:Sequence{self}" domainClass="unified::UnifiedSystemModel">
            <style xsi:type="style:SquareDescription" labelSize="11" showIcon="false" labelExpression="aql:'Hazard Coverage: ' + (self.computeHazardCoverage() * 100).round().toString() + '%'" labelPosition="node" resizeKind="NSEW" width="20" height="3">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
