        </containerMappings>
        <containerMappings name="MTABLE_FMEAMetrics_Container" semanticCandidatesExpression="aql:Sequence{self}" domainClass="unified::UnifiedSystemModel" childrenPresentation="List">
          <subNodeMappings name="MTABLE_TotalFMEAItems" semanticCandidatesExpression="aql:Sequence{self}" domainClass="unified::UnifiedSystemModel">
            <style xsi:type="style:SquareDescription" labelSize="11" showIcon="false" labelExpression="aql:'Total FMEA Items: ' + self.countTotalFMEAItems().toString()" labelPosition="node" resizeKind="NSEW" width="20" height="3">
