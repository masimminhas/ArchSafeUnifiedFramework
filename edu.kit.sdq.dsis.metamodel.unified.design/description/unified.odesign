            <conditionnalStyles predicateExpression="aql:self.computeAverageRPN() > 100.0">
              <style xsi:type="style:SquareDescription" borderSizeComputationExpression="2" labelSize="10" showIcon="false" labelExpression="aql:'⚠️ Average RPN: ' + self.computeAverageRPN().round().toString()" labelPosition="node" resizeKind="NSEW" width="20" height="3">
                <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
                <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_red']"/>
              </style>
            </conditionnalStyles>
          </subNodeMappings>
          <subNodeMappings name="MTABLE_HighRiskItems" semanticCandidatesExpression="aql:Sequence{self}" domainClass="unified::UnifiedSystemModel">
            <style xsi:type="style:SquareDescription" labelSize="11" showIcon="false" labelExpression="aql:'High-Risk Items: ' + self.countHighRiskItems().toString()" labelPosition="node" resizeKind="NSEW" width="20" height="3">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_red']"/>
            </style>
          </subNodeMappings>
          <style xsi:type="style:FlatContainerStyleDescription" borderSizeComputationExpression="2" labelSize="12" showIcon="false" labelExpression="📋 FMEA METRICS" tooltipExpression="FMEA analysis metrics" roundedCorner="true" widthComputationExpression="22" heightComputationExpression="15">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='orange']"/>
            <labelFormat>bold</labelFormat>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_orange']"/>
            <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            <foregroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_orange']"/>
          </style>
        </containerMappings>
        <containerMappings name="MTABLE_QualityScores_Container" semanticCandidatesExpression="aql:Sequence{self}" domainClass="unified::UnifiedSystemModel" childrenPresentation="List">
          <subNodeMappings name="MTABLE_CompletenessScore" semanticCandidatesExpression="aql:Sequence{self}" domainClass="unified::UnifiedSystemModel">
            <style xsi:type="style:SquareDescription" labelSize="11" showIcon="false" labelExpression="aql:'✅ Completeness: ' + self.computeCompletenessScore().toString() + '/100'" labelPosition="node" resizeKind="NSEW" width="20" height="4">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='green']"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_green']"/>
            </style>
            <conditionnalStyles predicateExpression="aql:self.computeCompletenessScore() &lt; 50">
              <style xsi:type="style:SquareDescription" borderSizeComputationExpression="3" labelSize="11" showIcon="false" labelExpression="aql:'⚠️ Completeness: ' + self.computeCompletenessScore().toString() + '/100'" labelPosition="node" resizeKind="NSEW" width="20" height="4">
                <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
                <labelFormat>bold</labelFormat>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
                <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_red']"/>
              </style>
            </conditionnalStyles>
          </subNodeMappings>
          <subNodeMappings name="MTABLE_ConsistencyScore" semanticCandidatesExpression="aql:Sequence{self}" domainClass="unified::UnifiedSystemModel">
            <style xsi:type="style:SquareDescription" labelSize="11" showIcon="false" labelExpression="aql:'✅ Consistency: ' + self.computeConsistencyScore().toString() + '/100'" labelPosition="node" resizeKind="NSEW" width="20" height="4">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='green']"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_green']"/>
            </style>
            <conditionnalStyles predicateExpression="aql:self.computeConsistencyScore() &lt; 70">
              <style xsi:type="style:SquareDescription" borderSizeComputationExpression="3" labelSize="11" showIcon="false" labelExpression="aql:'⚠️ Consistency: ' + self.computeConsistencyScore().toString() + '/100'" labelPosition="node" resizeKind="NSEW" width="20" height="4">
                <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='orange']"/>
                <labelFormat>bold</labelFormat>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='orange']"/>
                <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_orange']"/>
              </style>
            </conditionnalStyles>
          </subNodeMappings>
          <subNodeMappings name="MTABLE_TraceabilityDensity" semanticCandidatesExpression="aql:Sequence{self}" domainClass="unified::UnifiedSystemModel">
            <style xsi:type="style:SquareDescription" labelSize="11" showIcon="false" labelExpression="aql:'Traceability: ' + (self.computeTraceabilityDensity() * 100).round().toString() + '%'" labelPosition="node" resizeKind="NSEW" width="20" height="3">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_green']"/>
            </style>
            <conditionnalStyles predicateExpression="aql:self.computeTraceabilityDensity() &lt; 0.3">
              <style xsi:type="style:SquareDescription" borderSizeComputationExpression="2" labelSize="11" showIcon="false" labelExpression="aql:'⚠️ Traceability: ' + (self.computeTraceabilityDensity() * 100).round().toString() + '%'" labelPosition="node" resizeKind="NSEW" width="20" height="3">
                <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
                <labelFormat>bold</labelFormat>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
                <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_red']"/>
              </style>
            </conditionnalStyles>
          </subNodeMappings>
          <style xsi:type="style:FlatContainerStyleDescription" borderSizeComputationExpression="2" labelSize="12" showIcon="false" labelExpression="🎯 QUALITY SCORES" tooltipExpression="Overall model quality assessment" roundedCorner="true" widthComputationExpression="22" heightComputationExpression="13">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='green']"/>
            <labelFormat>bold</labelFormat>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_green']"/>
            <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            <foregroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_green']"/>
          </style>
        </containerMappings>
        <toolSections name="MetricsTableTools" label="📊 Metrics Actions">
          <ownedTools xsi:type="tool_1:OperationAction" name="RefreshMetricsTable" label="Refresh All Metrics" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/refresh.gif">
            <view name="views"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
                <subModelOperations xsi:type="tool_1:ExternalJavaAction" name="RefreshMetrics" id="edu.kit.sdq.dsis.unified.design.actions.MetricsAction"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:OperationAction" name="ExportMetricsTableReport" label="Export Metrics Report" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/metrics.gif">
            <view name="views"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
                <subModelOperations xsi:type="tool_1:ExternalJavaAction" name="ExportMetrics" id="edu.kit.sdq.dsis.unified.design.actions.ExportDetailedMetricsAction"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:OperationAction" name="GenerateRecommendationsTable" label="Generate Recommendations" icon="/edu.kit.sdq.dsis.metamodel.unified.design/icons/recommend.gif">
            <view name="views"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
                <subModelOperations xsi:type="tool_1:ExternalJavaAction" name="GenerateRecommendations" id="edu.kit.sdq.dsis.unified.design.actions.RecommendationAction"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
        </toolSections>
      </defaultLayer>
    </ownedRepresentations>
    <ownedRepresentations xsi:type="description_2:EditionTableDescription" name="FMEATable" label="FMEA Table" domainClass="unified::UnifiedSystemModel" initialHeaderColumnWidth="150">
      <metamodel href="http://edu.kit.sdq.dsis.metamodel/unified#/"/>
      <ownedLineMappings name="FMEAAnalysisLine" domainClass="unified::FMEAAnalysis" semanticCandidatesExpression="feature:fmeaAnalysis" headerLabelExpression="aql:self.name">
        <ownedSubLines name="FMEAItemLine" domainClass="unified::FMEAItem" semanticCandidatesExpression="feature:fmeaItems" headerLabelExpression="aql:self.name"/>
      </ownedLineMappings>
      <ownedCreateLine name="CreateFMEAAnalysis" label="Create FMEA Analysis" mapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEATable']/@ownedLineMappings[name='FMEAAnalysisLine']">
        <variables name="root" documentation="The semantic root element of the table."/>
        <variables name="element" documentation="The semantic currently edited element."/>
        <variables name="container" documentation="The semantic element corresponding to the view container."/>
        <firstModelOperation xsi:type="tool_1:ChangeContext" browseExpression="var:root">
          <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::FMEAAnalysis" referenceName="fmeaAnalysis" variableName="newAnalysis">
            <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'FMEA_Analysis_' + (root.fmeaAnalysis->size())"/>
            <subModelOperations xsi:type="tool_1:SetValue" featureName="rpnThreshold" valueExpression="100"/>
            <subModelOperations xsi:type="tool_1:SetValue" featureName="analysisStatus" valueExpression="aql:unified::AnalysisStatus::DRAFT"/>
          </subModelOperations>
        </firstModelOperation>
      </ownedCreateLine>
      <ownedCreateLine name="CreateFMEAItem" label="Create FMEA Item" precondition="aql:self.oclIsKindOf(unified::FMEAItem)" mapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='FMEATable']/@ownedLineMappings[name='FMEAAnalysisLine']/@ownedSubLines[name='FMEAItemLine']">
        <variables name="root" documentation="The semantic root element of the table."/>
        <variables name="element" documentation="The semantic currently edited element."/>
        <variables name="container" documentation="The semantic element corresponding to the view container."/>
        <firstModelOperation xsi:type="tool_1:ChangeContext" browseExpression="var:container">
          <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::FMEAItem" referenceName="fmeaItems" variableName="newItem">
            <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'FMEAItem_' + (container.fmeaItems->size())"/>
            <subModelOperations xsi:type="tool_1:SetValue" featureName="severity" valueExpression="5"/>
            <subModelOperations xsi:type="tool_1:SetValue" featureName="occurrence" valueExpression="3"/>
            <subModelOperations xsi:type="tool_1:SetValue" featureName="detection" valueExpression="4"/>
            <subModelOperations xsi:type="tool_1:SetValue" featureName="localEffect" valueExpression="Enter local effect"/>
            <subModelOperations xsi:type="tool_1:SetValue" featureName="systemEffect" valueExpression="Enter system effect"/>
            <subModelOperations xsi:type="tool_1:SetValue" featureName="actionStatus" valueExpression="aql:unified::ActionStatus::OPEN"/>
            <subModelOperations xsi:type="tool_1:SetValue" featureName="autoGenerated" valueExpression="false"/>
          </subModelOperations>
        </firstModelOperation>
      </ownedCreateLine>
      <ownedColumnMappings name="AnalysisNameColumn" headerLabelExpression="Analysis/Item Name" featureName="name" labelExpression="aql:self.name">
        <defaultForeground labelSize="10">
          <labelFormat>bold</labelFormat>
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        </defaultForeground>
      </ownedColumnMappings>
      <ownedColumnMappings name="ComponentColumn" headerLabelExpression="Component" featureName="analyzedComponent" labelExpression="aql:if self.oclIsKindOf(unified::FMEAItem) then if self.oclAsType(unified::FMEAItem).analyzedComponent = null then '' else self.oclAsType(unified::FMEAItem).analyzedComponent.name endif else '' endif">
        <defaultForeground labelSize="10">
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_blue']"/>
        </defaultForeground>
      </ownedColumnMappings>
      <ownedColumnMappings name="FailureModeColumn" headerLabelExpression="Failure Mode" featureName="failureMode" labelExpression="aql:if self.oclIsKindOf(unified::FMEAItem) then if self.oclAsType(unified::FMEAItem).failureMode = null then '' else self.oclAsType(unified::FMEAItem).failureMode.name endif else '' endif">
        <defaultForeground labelSize="10">
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        </defaultForeground>
      </ownedColumnMappings>
      <ownedColumnMappings name="LocalEffectColumn" headerLabelExpression="Local Effect" featureName="localEffect" labelExpression="aql:if self.oclIsKindOf(unified::FMEAItem) then if self.oclAsType(unified::FMEAItem).localEffect = null then '' else self.oclAsType(unified::FMEAItem).localEffect endif else '' endif">
        <defaultForeground labelSize="10">
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        </defaultForeground>
      </ownedColumnMappings>
      <ownedColumnMappings name="SystemEffectColumn" headerLabelExpression="System Effect" featureName="systemEffect" labelExpression="aql:if self.oclIsKindOf(unified::FMEAItem) then if self.oclAsType(unified::FMEAItem).systemEffect = null then '' else self.oclAsType(unified::FMEAItem).systemEffect endif else '' endif">
        <defaultForeground labelSize="10">
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        </defaultForeground>
      </ownedColumnMappings>
      <ownedColumnMappings name="SeverityColumn" headerLabelExpression="S" featureName="severity" labelExpression="aql:if self.oclIsKindOf(unified::FMEAItem) then self.oclAsType(unified::FMEAItem).severity.toString() else '' endif">
        <defaultForeground>
          <labelFormat>bold</labelFormat>
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
        </defaultForeground>
      </ownedColumnMappings>
      <ownedColumnMappings name="OccurrenceColumn" headerLabelExpression="O" featureName="occurrence" labelExpression="aql:if self.oclIsKindOf(unified::FMEAItem) then self.oclAsType(unified::FMEAItem).occurrence.toString() else '' endif">
        <defaultForeground>
          <labelFormat>bold</labelFormat>
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_orange']"/>
        </defaultForeground>
      </ownedColumnMappings>
      <ownedColumnMappings name="DetectionColumn" headerLabelExpression="D" featureName="detection" labelExpression="aql:if self.oclIsKindOf(unified::FMEAItem) then self.oclAsType(unified::FMEAItem).detection.toString() else '' endif">
        <defaultForeground>
          <labelFormat>bold</labelFormat>
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_blue']"/>
        </defaultForeground>
      </ownedColumnMappings>
      <ownedColumnMappings name="RPNColumn" headerLabelExpression="RPN" canEdit="false" featureName="severity" labelExpression="aql:if self.oclIsKindOf(unified::FMEAItem) then (self.oclAsType(unified::FMEAItem).severity * self.oclAsType(unified::FMEAItem).occurrence * self.oclAsType(unified::FMEAItem).detection).toString() else '' endif">
        <defaultForeground>
          <labelFormat>bold</labelFormat>
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='purple']"/>
        </defaultForeground>
        <foregroundConditionalStyle predicateExpression="aql:self.oclIsKindOf(unified::FMEAItem) and (self.oclAsType(unified::FMEAItem).severity * self.oclAsType(unified::FMEAItem).occurrence * self.oclAsType(unified::FMEAItem).detection) > 100">
          <style>
            <labelFormat>bold</labelFormat>
            <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
          </style>
        </foregroundConditionalStyle>
      </ownedColumnMappings>
      <ownedColumnMappings name="RecommendedActionColumn" headerLabelExpression="Recommended Action" featureName="recommendedAction" labelExpression="aql:if self.oclIsKindOf(unified::FMEAItem) then if self.oclAsType(unified::FMEAItem).recommendedAction = null then '' else self.oclAsType(unified::FMEAItem).recommendedAction endif else '' endif">
        <defaultForeground labelSize="10">
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        </defaultForeground>
      </ownedColumnMappings>
      <ownedColumnMappings name="ActionStatusColumn" headerLabelExpression="Status" featureName="actionStatus" labelExpression="aql:if self.oclIsKindOf(unified::FMEAItem) then self.oclAsType(unified::FMEAItem).actionStatus.toString() else '' endif">
        <defaultForeground labelSize="10">
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_green']"/>
        </defaultForeground>
        <foregroundConditionalStyle predicateExpression="aql:self.oclIsKindOf(unified::FMEAItem) and (self.oclAsType(unified::FMEAItem).actionStatus = unified::ActionStatus::COMPLETED or self.oclAsType(unified::FMEAItem).actionStatus = unified::ActionStatus::VERIFIED)">
          <style>
            <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='green']"/>
          </style>
        </foregroundConditionalStyle>
        <foregroundConditionalStyle predicateExpression="aql:self.oclIsKindOf(unified::FMEAItem) and self.oclAsType(unified::FMEAItem).actionStatus = unified::ActionStatus::OPEN">
          <style>
            <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
          </style>
        </foregroundConditionalStyle>
      </ownedColumnMappings>
      <ownedColumnMappings name="ResponsiblePersonColumn" headerLabelExpression="Responsible" featureName="responsiblePerson" labelExpression="aql:if self.oclIsKindOf(unified::FMEAItem) then if self.oclAsType(unified::FMEAItem).responsiblePerson = null then '' else self.oclAsType(unified::FMEAItem).responsiblePerson endif else '' endif">
        <defaultForeground labelSize="10">
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        </defaultForeground>
      </ownedColumnMappings>
      <ownedColumnMappings name="DueDateColumn" headerLabelExpression="Due Date" featureName="dueDate" labelExpression="aql:if self.oclIsKindOf(unified::FMEAItem) then if self.oclAsType(unified::FMEAItem).dueDate = null then '' else self.oclAsType(unified::FMEAItem).dueDate.toString() endif else '' endif">
        <defaultForeground labelSize="10">
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
        </defaultForeground>
      </ownedColumnMappings>
      <ownedColumnMappings name="AutoGeneratedColumn" headerLabelExpression="Auto" canEdit="false" featureName="autoGenerated" labelExpression="aql:if self.oclIsKindOf(unified::FMEAItem) then if self.oclAsType(unified::FMEAItem).autoGenerated then 'Yes' else 'No' endif else '' endif">
        <defaultForeground labelSize="10">
          <foreGroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
        </defaultForeground>
      </ownedColumnMappings>
      <delete name="DeleteFMEALine" label="Delete">
    <variables name="root" documentation="The semantic root element of the table."/>
    <variables name="element" documentation="The semantic currently edited element."/>
    <variables name="container" documentation="The semantic element corresponding to the view container."/>
    <firstModelOperation xsi:type="tool_1:RemoveElement"/>
  </delete>
    </ownedRepresentations>
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="RequirementsDiagram" label="Requirements Diagram" domainClass="unified::UnifiedSystemModel" enablePopupBars="true">
      <metamodel href="http://edu.kit.sdq.dsis.metamodel/unified#/"/>
      <validationSet name="requirementsValidation">
        <ownedRules xsi:type="validation:SemanticValidationRule" name="SafetyGoalHasASIL" level="ERROR" message="Safety Goal must have an ASIL level assigned." targetClass="unified::SafetyGoal">
          <audits auditExpression="aql:self.asilLevel != null"/>
        </ownedRules>
        <ownedRules xsi:type="validation:SemanticValidationRule" name="RequirementHasText" level="ERROR" message="Requirement must have requirement text defined." targetClass="unified::Requirement">
          <audits auditExpression="aql:self.requirementText != null and self.requirementText.size() > 0"/>
        </ownedRules>
      </validationSet>
      <defaultLayer name="RequirementsLayer">
        <nodeMappings name="REQ_FunctionalReq_Node" semanticCandidatesExpression="feature:functionalRequirements" domainClass="unified::FunctionalSafetyRequirement">
          <style xsi:type="style:SquareDescription" labelSize="10" showIcon="false" labelExpression="aql:self.requirementId + ': ' + self.name" labelPosition="node" resizeKind="NSEW" width="14" height="6">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_blue']"/>
            <labelFormat>bold</labelFormat>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_blue']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="REQ_TechnicalReq_Node" semanticCandidatesExpression="feature:technicalRequirements" domainClass="unified::TechnicalSafetyRequirement">
          <style xsi:type="style:SquareDescription" labelSize="10" showIcon="false" labelExpression="aql:self.requirementId + ': ' + self.name" labelPosition="node" resizeKind="NSEW" width="14" height="6">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_green']"/>
            <labelFormat>bold</labelFormat>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_green']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="REQ_SafetyMechanism_Node" semanticCandidatesExpression="feature:safetyMechanisms" domainClass="unified::SafetyMechanism">
          <style xsi:type="style:SquareDescription" labelSize="9" showIcon="false" labelExpression="aql:self.name + ' [' + self.mechanismType.toString() + ']'" labelPosition="node" resizeKind="NSEW" width="12" height="5">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='purple']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_purple']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="REQ_Hazard_Node" semanticCandidatesExpression="feature:globalHazards" domainClass="unified::IntegratedHazard">
          <style xsi:type="style:EllipseNodeDescription" labelSize="9" showIcon="false" labelExpression="aql:self.name" labelPosition="node" resizeKind="NSEW" width="10" height="5">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='orange']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_orange']"/>
          </style>
        </nodeMappings>
        <edgeMappings name="REQ_HazardToGoal_Edge" semanticCandidatesExpression="aql:self.globalHazards" sourceMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@nodeMappings[name='REQ_Hazard_Node']" targetMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@containerMappings[name='REQ_SafetyGoal_Container']" targetFinderExpression="aql:self.eContainer().safetyGoals->select(sg | sg.relatedHazard = self)" sourceFinderExpression="aql:self" domainClass="unified::IntegratedHazard" useDomainElement="true">
          <style sizeComputationExpression="2" routingStyle="manhattan">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='orange']"/>
            <centerLabelStyleDescription showIcon="false" labelExpression="addresses">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_gray']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <edgeMappings name="REQ_GoalToFunctional_Edge" semanticCandidatesExpression="aql:self.safetyGoals" sourceMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@containerMappings[name='REQ_SafetyGoal_Container']" targetMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@nodeMappings[name='REQ_FunctionalReq_Node']" targetFinderExpression="aql:self.allocatedTo" sourceFinderExpression="aql:self" domainClass="unified::SafetyGoal" useDomainElement="true">
          <style targetArrow="InputFillClosedArrow" sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
            <centerLabelStyleDescription showIcon="false" labelExpression="allocates to">
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <edgeMappings name="REQ_FunctionalToTechnical_Edge" semanticCandidatesExpression="aql:self.functionalRequirements" sourceMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@nodeMappings[name='REQ_FunctionalReq_Node']" targetMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@nodeMappings[name='REQ_TechnicalReq_Node']" targetFinderExpression="aql:self.refinedTo" sourceFinderExpression="aql:self" domainClass="unified::FunctionalSafetyRequirement" useDomainElement="true">
          <style lineStyle="dash" targetArrow="InputFillClosedArrow" sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_blue']"/>
            <centerLabelStyleDescription showIcon="false" labelExpression="refines to">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_blue']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <edgeMappings name="REQ_TechnicalToMechanism_Edge" semanticCandidatesExpression="aql:self.safetyMechanisms" sourceMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@nodeMappings[name='REQ_TechnicalReq_Node']" targetMapping="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@nodeMappings[name='REQ_SafetyMechanism_Node']" targetFinderExpression="aql:self" sourceFinderExpression="feature:implements" domainClass="unified::SafetyMechanism" useDomainElement="true">
          <style lineStyle="dot" targetArrow="InputFillClosedArrow">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='purple']"/>
            <centerLabelStyleDescription showIcon="false" labelExpression="implemented by">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='purple']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <containerMappings name="REQ_SafetyGoal_Container" semanticCandidatesExpression="feature:safetyGoals" domainClass="unified::SafetyGoal">
          <style xsi:type="style:FlatContainerStyleDescription" labelSize="10" labelExpression="aql:self.requirementId + ': ' + self.name" roundedCorner="true" borderSize="2">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
            <labelFormat>bold</labelFormat>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
            <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_yellow']"/>
            <foregroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_gray']"/>
          </style>
        </containerMappings>
        <toolSections name="RequirementsTools" label="Requirements Tools">
          <ownedTools xsi:type="tool:ContainerCreationDescription" name="REQ_Create_SafetyGoal" label="Safety Goal" containerMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@containerMappings[name='REQ_SafetyGoal_Container']" iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/safety-goal.gif">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::SafetyGoal" referenceName="safetyGoals" variableName="newGoal">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'SafetyGoal_' + (container.safetyGoals->size() + 1)"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="requirementId" valueExpression="aql:'SG-' + (container.safetyGoals->size() + 1).toString()"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="asilLevel" valueExpression="aql:unified::ASILLevel::ASIL_B"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="status" valueExpression="aql:unified::RequirementStatus::DRAFT"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:NodeCreationDescription" name="REQ_Create_Functional" label="Functional Safety Requirement" nodeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@nodeMappings[name='REQ_FunctionalReq_Node']" iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/functional-req.gif">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::FunctionalSafetyRequirement" referenceName="functionalRequirements" variableName="newReq">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'FSR_' + (container.functionalRequirements->size() + 1)"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="requirementId" valueExpression="aql:'FSR-' + (container.functionalRequirements->size() + 1).toString()"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="status" valueExpression="aql:unified::RequirementStatus::DRAFT"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:NodeCreationDescription" name="REQ_Create_Technical" label="Technical Safety Requirement" nodeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@nodeMappings[name='REQ_TechnicalReq_Node']" iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/technical-req.gif">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::TechnicalSafetyRequirement" referenceName="technicalRequirements" variableName="newReq">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'TSR_' + (container.technicalRequirements->size() + 1)"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="requirementId" valueExpression="aql:'TSR-' + (container.technicalRequirements->size() + 1).toString()"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="status" valueExpression="aql:unified::RequirementStatus::DRAFT"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:NodeCreationDescription" name="REQ_Create_SafetyMechanism" label="Safety Mechanism" nodeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@nodeMappings[name='REQ_SafetyMechanism_Node']" iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/safety-mechanism.gif">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="unified::SafetyMechanism" referenceName="safetyMechanisms" variableName="newMech">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'SafetyMechanism_' + (container.safetyMechanisms->size() + 1)"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="mechanismType" valueExpression="aql:unified::SafetyMechanismType::REDUNDANCY"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="REQ_Link_HazardToGoal" label="Link Hazard to Goal" edgeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@edgeMappings[name='REQ_HazardToGoal_Edge']" iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/link.gif">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:target">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="relatedHazard" valueExpression="var:source"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="REQ_Allocate_GoalToFunctional" label="Allocate to Functional" edgeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@edgeMappings[name='REQ_GoalToFunctional_Edge']" iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/allocate.gif">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:source">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="allocatedTo" valueExpression="aql:self.allocatedTo->including(target)"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="REQ_Refine_FunctionalToTechnical" label="Refine to Technical" edgeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@edgeMappings[name='REQ_FunctionalToTechnical_Edge']" iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/refine.gif">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:source">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="refinedTo" valueExpression="aql:self.refinedTo->including(target)"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="REQ_Link_TechnicalToMechanism" label="Link to Mechanism" edgeMappings="//@ownedViewpoints[name='UnifiedModeling']/@ownedRepresentations[name='RequirementsDiagram']/@defaultLayer/@edgeMappings[name='REQ_TechnicalToMechanism_Edge']" iconPath="/edu.kit.sdq.dsis.metamodel.unified.design/icons/link.gif">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:target">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="implements" valueExpression="aql:self.implements->including(source)"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
        </toolSections>
      </defaultLayer>
    </ownedRepresentations>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.metamodel.unified.design.Services"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.services.AdvancedAnalysisServices"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.ValidateConsistencyAction"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.MetricsAction"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.ExportArchitectureAction"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.ExportFMEAAction"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.ExportDetailedMetricsAction"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.GenerateFMEAAction"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.RecommendationAction"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.ImpactAnalysisAction"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.HazardAnalysisAction"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.ExportTraceabilityAction"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.TraceabilityQueryAction"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.ValidateTraceabilityQueryAction"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.HighlightTraceChainAction"/>
    <ownedJavaExtensions qualifiedClassName="edu.kit.sdq.dsis.unified.design.actions.GenerateTraceabilityReportAction"/>
  </ownedViewpoints>
</description:Group>
